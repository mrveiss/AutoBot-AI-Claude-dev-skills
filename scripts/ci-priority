#!/usr/bin/env bash
# ci-priority PR [PR...] — give the PR(s) that land next the whole runner pool: cancel every
# in-flight workflow run whose head branch is not one of theirs. GitHub has no "pause"; a
# cancelled PR gets its fresh run when its turn comes (it has to update to main then anyway).
# Owner rule 2026-09-19: "make sure that CI of pr that supposed to land first is running with
# priority, pause the ones that will have to land later". Runs on main (post-merge verification)
# are kept. Dry run with CI_PRIORITY_DRY=1.
set -u
REPO=mrveiss/AutoBot-AI
[ $# -ge 1 ] || { echo "usage: ci-priority PR [PR...]" >&2; exit 2; }
keep="main"
for p in "$@"; do
  b=$(gh pr view "$p" --repo $REPO --json headRefName -q .headRefName 2>/dev/null) || { echo "#$p: not found" >&2; exit 2; }
  keep="$keep $b"
done
# Every PR holding a ledger ci-slot is kept too: those are trains about to merge, and a
# cancel there costs a full rerun (owner, 2026-10-16: "patch both to skip branches whose PR
# holds a ci-slot"). pr-coordinator keeps ci-slot pins; this tool did not, so a safe-merge of one
# PR cancelled another session's train (#18589, 2026-10-16).
for p in $("$HOME/.claude/scripts/ledger" holds 2>/dev/null | sed -n 's/^ci-slot:\([0-9][0-9]*\).*/\1/p'); do
  b=$(gh pr view "$p" --repo $REPO --json headRefName,state -q 'select(.state=="OPEN")|.headRefName' 2>/dev/null)
  [ -n "$b" ] && { keep="$keep $b"; echo "kept: #$p ($b) holds ledger ci-slot:$p"; }
done
# Keep main for push (post-merge verification, own lane keys) and for workflow_dispatch/schedule:
# maintenance runs on main (test-durations refresh, 2026-10-26) are what a train waits on.
# Otherwise main is not kept. A pull_request run whose head
# is main (the release-promotion PR) shares the PR shard lanes and lands later: it gets paused too.
ids=$(gh run list --repo $REPO --limit 300 --json databaseId,status,headBranch,event,workflowName \
  -q '.[]|select(.status!="completed" and .workflowName!="Dispatch Preboard Guards")|"\(.databaseId) \(.headBranch) \(.event)"' \
  | awk -v k=" $keep " '!($2=="main" && ($3=="push" || $3=="workflow_dispatch" || $3=="schedule")) && !($2!="main" && index(k, " "$2" ")>0) {print $1}')
n=$(grep -c . <<<"$ids")
echo "priority to: $*  (branches kept: $keep); cancelling $n other in-flight run(s)"
[ "${CI_PRIORITY_DRY:-}" = 1 ] && exit 0
[ "$n" -gt 0 ] && xargs -r -P6 -I{} "$HOME/.claude/scripts/ci-cancel" {} ci-priority "priority to: $*" <<<"$ids" | sort | uniq -c
