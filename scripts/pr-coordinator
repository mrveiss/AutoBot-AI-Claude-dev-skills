#!/usr/bin/env python3
"""pr-coordinator [--dry] — one tick of the cross-session PR traffic light (owner rules 2026-11-18).

  1 FIFO: PRs are admitted strictly in ARRIVAL order (ascending PR number = creation order; owner 2026-11-28), after the
    unblocker lane (batch=unblocker) and with deps.json pins kept; the milestone no longer orders anything, it is only displayed. A PR that is draft, conflicting or red keeps
    its place but gets no CI slot; once fixed it is ahead of everything submitted after it.
    Approval of an external PR (ledger approve; --fork-approved for forks) is recorded by an OWNER-side session after a reviewer pass; this tool's own identity never approves.
    The release promotion (#19456) is always last. External (fork) PRs are slotted like own PRs (owner 2026-11-27:
    "we are owners, we do not need approval, we do the approval"); every landing gate still applies.
  2 At most WIDTH (2) PRs hold CI. Slots are ledger holds `ci-slot:N` (other sessions' holds count).
    A granted slot is kept through red and conflict until the PR merges, closes or gets a ledger hold
    (owner 2026-11-28: finish one landing before taking the next); a red slot PR is reported, never replaced.
    CI is DISPATCHED by this tool for slot PRs (workflow_dispatch; dual mode with the legacy path until main's ci.yml
    loses `pull_request`; PR_COORDINATOR_DISPATCH=0 is the kill switch). Parking holds BEFORE cutover (every
    non-slot ready PR is drafted + `ci-parked`); after cutover it is over and existing ones are unparked once. A draft without that label is the author's own.
    A ledger approve is required for EXTERNAL PRs only (fork or non-owner author); own PRs merge on quality.
    The release promotion (#19456) gets a slot only by a manual ledger ci-slot hold.
    Every other PR's in-flight Actions runs are cancelled through ci-cancel. A slot PR that is behind
    main is updated (update-branch); its cancelled runs are re-run. Only the oldest slot PR may land.
  3 CodeRabbit threads awaiting a reply are reported for EVERY open PR, at once, regardless of CI.
  4 A red check at a PR's head cancels that PR's remaining runs and pages its creator session.
    Exception: a check that failed on runner infrastructure (INFRA_PATTERNS) is re-run once per
    (PR, head, job) and logged INFRA-RERUN; a second failure or any other failure is red as above.
No active trainmaster is assumed; when one is active (ledger hold `trainmaster`), this tool reports only.
Prints the queue + an ATTENTION block (JSON lines) the coordinator session relays to owners.
State: ~/.claude/state/pr-coordinator/ (notified keys, queue.md).
"""
import datetime, fcntl, hashlib, importlib.machinery, importlib.util, json, os, re, subprocess, sys, tempfile, time
from pathlib import Path

REPO, WIDTH, LAST = "mrveiss/AutoBot-AI", 2, {19456}
ME = "pr-coordinator"
STUCK_SLOT_SECS = int(os.environ.get("PR_COORDINATOR_STUCK_SLOT_SECS", 6 * 3600))   # red/conflicting slot PR: page after this
PARK_LABEL = "ci-parked"   # we drafted this PR to keep it off CI (AutoBot-AI#20825); admission undoes it
SLOT_LABEL = "land-next"   # marks slot PRs; the sync workflow merges main only into these (owner 2026-11-18)
PROTECTED = {"main", "release", "master"}   # a promotion PR's head is main: its runs are main's own CI
S = Path.home() / ".claude/scripts"
STATE = Path.home() / ".claude/state/pr-coordinator"
DRY = "--dry" in sys.argv
# Every live pass takes this lock itself (#57). It must NOT be the loop's `flock -n /tmp/pr-coordinator.lock` file:
# flock(1) holds that one on its own open file description, so a second flock() on the same path would always block.
LOCK_PATH = os.environ.get("PR_COORDINATOR_PASS_LOCK", "/tmp/pr-coordinator.pass.lock")
USAGE = """usage: pr-coordinator [--dry | --proof-check PR | --dispatch PR | --findings-gate PR | -h | --help]
  (no args)           one live coordinator pass (takes the pass lock)
  --dry               read-only pass, no lock
  --proof-check PR    validate PR's requirement-proof table, no lock
  --dispatch PR       dispatch CI for one slot PR's head now (push-and-park); 3 = PR holds no slot
  --findings-gate PR  dispatch pr-blocking-findings for the head and wait (safe-merge); 0 ok, 1 fail, 3 not applicable
  -h, --help          this text"""
# Owner 2026-11-23: a head pushed after this instant needs a valid requirement-proof table in the PR body before CI starts.
PROOF_CUTOFF = os.environ.get("PR_COORDINATOR_PROOF_CUTOFF", "2026-11-23T11:36:00Z")
try:
    if datetime.datetime.fromisoformat(PROOF_CUTOFF.strip().replace("Z", "+00:00")).tzinfo is None:
        raise ValueError("no timezone")
except ValueError as exc:
    raise SystemExit(f"PR_COORDINATOR_PROOF_CUTOFF {PROOF_CUTOFF!r} is not an ISO-8601 instant with a timezone: {exc}")
# A Reviewer cell holding one of these is a placeholder, not a sign-off (an empty cell is rejected earlier, as an empty cell).
UNSIGNED_REVIEWER = {"", "pending", "tbd", "todo", "?", "-", "\u2014"}
# Only the LEADING verdict of a Reviewer cell counts; text after it (parentheses, quoted code) is ignored.
REVIEWER_SIGNER = re.compile(r"^[\w-]*:?reviewer\b(\s*\([^)]*\))?\s*[:\u2014\u2013-]?\s*", re.I)   # "autobot-dev-skills:reviewer \u2014 "
VERDICT_LEAD = r"[\s*_`]*"                                                                       # emphasis before the verdict
NEGATIVE_VERDICT = re.compile(r"(fail|fails|failed|does not hold|doesn['\u2019]t hold|not hold|not verified|no longer holds"
                              r"|blocked|request(ed)? changes|changes requested|rejected)\b", re.I)
POSITIVE_VERDICT = re.compile(r"(holds|verified)\b", re.I)   # "holds" / "holds at <sha>" / "verified"


def reviewer_verdict_ok(cell):
    """True when the cell STARTS (after emphasis and an optional reviewer signer) with a positive verdict."""
    rest = re.sub("^" + VERDICT_LEAD, "", cell)
    rest = re.sub("^" + VERDICT_LEAD, "", REVIEWER_SIGNER.sub("", rest, 1))
    return not NEGATIVE_VERDICT.match(rest) and bool(POSITIVE_VERDICT.match(rest))
PROOF_COLUMNS = ["ac", "precondition", "postcondition", "establishing lines", "argument", "reviewer"]
RED = {"FAILURE", "TIMED_OUT", "STARTUP_FAILURE", "ERROR", "ACTION_REQUIRED"}
# Contexts that go red BECAUSE a PR is parked: ci-dispatch-watchdog fails any head with no executed CI
# (#12823/#13045). For a parked PR that is the queue working, not a defect; counting it as red would bar
# the PR from ever getting the slot that would clear it.
PARKING_ARTIFACTS = {"ci-dispatch-watchdog"}
# Contexts that fail on MAIN itself because of a tracked defect: {context: fix PR}. A PR red only on these
# is not at fault and must not lose its FIFO place; once it next holds a slot it is updated to main and
# reruns. Remove an entry once its fix has landed and the stale reds have cycled through.
_bd = Path.home() / ".claude/state/pr-coordinator/base-defects.json"
BASE_DEFECTS = json.loads(_bd.read_text(encoding="utf-8")) if _bd.exists() else {}
# {"<pr>": "<head sha[:9]>"}: a red at exactly that head is known stale (e.g. a run made while the PR was a
# draft, #18106) and must not bar the PR from the slot that gives it a fresh run. A new head ends the override.
_rc = Path.home() / ".claude/state/pr-coordinator/recheck.json"
RECHECK = json.loads(_rc.read_text(encoding="utf-8")) if _rc.exists() else {}
# {"<pr>": "<review_sha[:9]>"}: the owner asked to keep CI running at a review-blocked head for signal
# (e.g. "does this move a ratchet baseline"). It may hold a slot but still never lands until approved.
_sr = Path.home() / ".claude/state/pr-coordinator/signal-run.json"
SIGNAL_RUN = json.loads(_sr.read_text(encoding="utf-8")) if _sr.exists() else {}
PREBOARD_WORKFLOW = "dispatch-preboard-guards.yml"   # AutoBot-AI's dispatch-only guard lane (its header documents the artifact)
PREBOARD_ARTIFACT = "preboard-guards-result"
PREBOARD_OK = {"green", "green_with_skips"}           # `overall` values that mean the lane found nothing
PREBOARD_PASS = {"success", "green", "green_with_skips"}   # check statuses not listed as failing in a guards-advisory page
PREBOARD_MAX_TRIES = int(os.environ.get("PR_COORDINATOR_PREBOARD_MAX_TRIES", "2"))   # dispatch attempts per head (failures count)
PREBOARD_LIST_CAP = 10                                # failing items named in one page (count capped, text not)
# gh's wording when the branch has no such workflow file, no workflow_dispatch trigger or no `base` input (from gh's
# messages as remembered, not captured): the lane is then unavailable for THAT branch, not broken.
LANE_MISSING = re.compile(r"could not find any workflow|workflow_dispatch|unexpected inputs|HTTP 404|HTTP 422|not found", re.I)
NO_MILESTONE_RANK = 10**6   # a PR with no milestone, or a non-"M<n>" one, lands after every numbered milestone
MILESTONE_NUM = re.compile(r"^\s*M(\d+)\b")
ACTIVE = {"QUEUED", "IN_PROGRESS", "WAITING", "PENDING", "REQUESTED"}

Q = """query($c:String){repository(owner:"mrveiss",name:"AutoBot-AI"){pullRequests(states:OPEN,first:100,after:$c){
pageInfo{hasNextPage endCursor} nodes{number title createdAt updatedAt isDraft body changedFiles headRefName headRefOid baseRefName headRepository{nameWithOwner} isCrossRepository maintainerCanModify mergeStateStatus mergeable milestone{title} author{login} labels(first:30){nodes{name}}}}}}"""
THREADS = """reviewThreads(first:60){nodes{id isResolved comments(first:1){nodes{author{login}}}
  last:comments(last:1){nodes{author{login} createdAt url}}}}"""
CHECKS = """commits(last:1){nodes{commit{statusCheckRollup{contexts(first:100){nodes{
  ... on CheckRun{name status conclusion startedAt databaseId checkSuite{workflowRun{workflow{name}}}} ... on StatusContext{context state createdAt}}}}}}}"""
DETAIL_CHUNK = 8   # GraphQL cost scales with requested nodes; small aliased batches stay under the per-minute limit


MIGRATION_GROUP = set(json.loads((STATE / "migration-siblings.json").read_text(encoding="utf-8"))
                      .get("members", {})) if (STATE / "migration-siblings.json").exists() else set()


def migration_gate_ran(head):
    """True when a run-migration-gate job concluded success (not skipped) in a CI run at this head."""
    out = sh("gh", "api", f"repos/{REPO}/actions/runs?head_sha={head}&per_page=50", "--jq",
             '.workflow_runs[]|select(.path==".github/workflows/ci.yml")|.id')
    for rid in out.split():
        jobs = sh("gh", "api", f"repos/{REPO}/actions/runs/{rid}/jobs?per_page=100", "--jq",
                  '.jobs[]|select(.name|test("migration-gate|migration_gate"))|.conclusion')
        if "success" in jobs.split():
            return True
    return False


def write_atomic(path, text):
    """State files are read by concurrent ticks (push-and-park runs --dry): write a temp file in the same
    directory, then os.replace, so a reader sees the old or the new content, never a torn file."""
    path = Path(path)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)


def sh_rc(*cmd):
    """(returncode, stdout, stderr): for the calls whose failure must be read, not swallowed."""
    p = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8")
    return p.returncode, p.stdout.strip(), p.stderr.strip()


def sh(*cmd, check=False):
    p = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8")
    if check and p.returncode:
        raise SystemExit(f"{cmd[0]} failed: {p.stderr.strip()[:300]}")
    return p.stdout.strip()


def ledger_mod():
    path = str(S / "ledger")
    loader = importlib.machinery.SourceFileLoader("ledger", path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("ledger", loader))
    loader.exec_module(mod)
    return mod


def gql(query, **var):
    args = ["gh", "api", "graphql", "-f", f"query={query}"] + [x for k, v in var.items() for x in ("-f", f"{k}={v}")]
    for attempt in range(3):                  # a heavy page can come back truncated; retry before failing
        try:
            return json.loads(sh(*args, check=True))["data"]
        except (ValueError, KeyError, TypeError, SystemExit):
            if attempt == 2:
                raise
            time.sleep(5)


def milestone_rank(p):
    """Landing rank from the leading M<digits> of the milestone title ("M4 - Deforking" -> 4); no milestone
    or a non-M title -> NO_MILESTONE_RANK, so those PRs land after every numbered milestone."""
    m = MILESTONE_NUM.match((p.get("milestone") or {}).get("title") or "")
    return int(m.group(1)) if m else NO_MILESTONE_RANK


def admission_key(p):
    """Admission order: strictly arrival order (ascending PR number); only the explicit LAST set goes after."""
    return (p["number"] in LAST, p["number"])


def ms_label(p):
    """Queue-table milestone cell: "M<n>" when the rank came from a numbered milestone, else "-"."""
    k = milestone_rank(p)
    return "-" if k == NO_MILESTONE_RANK else f"M{k}"


def fetch_prs():
    """Light list of every open PR, then threads (non-draft) and checks (slot candidates) in small batches."""
    prs, cur = [], None
    while True:
        page = gql(Q, **({"c": cur} if cur else {}))["repository"]["pullRequests"]
        prs += page["nodes"]
        if not page["pageInfo"]["hasNextPage"]:
            break
        cur = page["pageInfo"]["endCursor"]
    # Threads change only when the PR's updatedAt does: cache them per (number, updatedAt). Checks are fetched
    # fresh, but only for slot candidates. Fetching both for ~90 PRs every tick spent the whole 5000-point
    # GraphQL hour on 2026-11-18.
    cache_path = STATE / "threads-cache.json"
    cache = json.loads(cache_path.read_text(encoding="utf-8")) if cache_path.exists() else {}
    new_cache = {}
    want = []
    for p in prs:
        p["reviewThreads"], p["commits"] = {"nodes": []}, {"nodes": []}
        if p["isDraft"] and not is_parked(p):     # a parked draft is ours: it still needs threads and red data
            continue
        hit = cache.get(str(p["number"]))
        threads = not (hit and hit["updatedAt"] == p["updatedAt"])
        if not threads:
            p["reviewThreads"] = hit["threads"]
        checks = p["mergeable"] != "CONFLICTING" and p["changedFiles"] > 0
        if threads or checks:
            want.append((p, threads, checks))
    for i in range(0, len(want), DETAIL_CHUNK):
        chunk = want[i:i + DETAIL_CHUNK]
        parts = [f'p{p["number"]}:pullRequest(number:{p["number"]}){{{THREADS if t else ""} {CHECKS if c else ""}}}'
                 for p, t, c in chunk]
        data = gql('{repository(owner:"mrveiss",name:"AutoBot-AI"){' + " ".join(parts) + "}}")["repository"]
        for p, _, _ in chunk:
            p.update({k: v for k, v in (data.get(f'p{p["number"]}') or {}).items()})
    for p in prs:
        if not p["isDraft"] or is_parked(p):
            new_cache[str(p["number"])] = {"updatedAt": p["updatedAt"], "threads": p["reviewThreads"]}
    if not DRY:
        write_atomic(cache_path, json.dumps(new_cache))
    return prs


def _advisory_run(c):
    """True for a CheckRun owned by an advisory workflow (the preboard lane, landing notes). Required-context
    publishers stay out of this set: their failures are real gates."""
    wf = (((c.get("checkSuite") or {}).get("workflowRun") or {}).get("workflow") or {}).get("name")
    return wf in EXEMPT_WORKFLOWS - REQUIRED_CONTEXT_PUBLISHERS


def ci_state(pr):
    """Latest attempt per context: (red names, active count, total contexts)."""
    nodes = pr["commits"]["nodes"]
    ctx = (nodes[0]["commit"]["statusCheckRollup"] or {}).get("contexts", {}).get("nodes", []) if nodes else []
    latest, ids = {}, {}
    for c in ctx:
        if _advisory_run(c):
            continue                              # the preboard lane etc. is advisory: never red, active or counted (#55)
        name = c.get("name") or c.get("context")
        stamp = c.get("startedAt") or c.get("createdAt") or ""
        if name and (name not in latest or stamp >= latest[name][0]):
            latest[name] = (stamp, c.get("conclusion") or c.get("state"), c.get("status"))
            ids[name] = c.get("databaseId")
    active = sum(1 for n, (_, concl, st) in latest.items() if n not in PARKING_ARTIFACTS
                 and (st in ACTIVE or concl in ACTIVE or (st is None and concl is None)))
    red = sorted(n for n, (_, concl, _) in latest.items() if concl in RED and n not in PARKING_ARTIFACTS)
    pr["red_ids"] = {n: ids.get(n) for n in red}
    if red and set(red) <= set(BASE_DEFECTS) and not any(contains_fix(pr["headRefOid"], BASE_DEFECTS[n]) for n in red):
        red = []                                  # red only on a main defect whose fix this head predates
    if red and not pr.get("isDraft") and all(ids.get(n) and draft_gated(ids[n]) for n in red):
        red = []                                  # every failure is the #18106 draft gate: stale once ready
    if red and RECHECK.get(str(pr["number"])) == pr["headRefOid"][:9]:
        red = []                                  # owner-verified stale red at exactly this head: rerun in a slot
    pr["action_required"] = [n for n in red if latest[n][1] == "ACTION_REQUIRED"]
    return red, active, len(latest)


_DRAFT_CACHE = {}
DRAFT_GATE_TEXT = "draft: mark ready for review"   # the #18106 draft gate's error line


def draft_gated(check_id):
    """True when this failed check run's only story is the draft gate (it never ran the work)."""
    if check_id not in _DRAFT_CACHE:
        notes = sh("gh", "api", f"repos/{REPO}/check-runs/{check_id}/annotations", "--jq", "[.[].message]|join(\"\\n\")")
        _DRAFT_CACHE[check_id] = bool(notes) and DRAFT_GATE_TEXT in notes
    return _DRAFT_CACHE[check_id]


def contains_fix(head, fix):
    """True when the head already contains the base-defect fix (merged commit sha); an open fix PR (int) is in no head."""
    if not isinstance(fix, str):
        return False
    return sh("gh", "api", f"repos/{REPO}/compare/{fix}...{head}", "--jq", ".status") in ("ahead", "identical")




def rabbit_threads(pr):
    """Unresolved threads opened by CodeRabbit whose last word is CodeRabbit's (awaiting a reply)."""
    out = []
    for t in pr["reviewThreads"]["nodes"]:
        first = (t["comments"]["nodes"] or [{}])[0].get("author") or {}
        last = (t["last"]["nodes"] or [{}])[0]
        if not t["isResolved"] and "coderabbit" in (first.get("login") or "") \
                and "coderabbit" in ((last.get("author") or {}).get("login") or ""):
            out.append((t["id"], last.get("createdAt", ""), last.get("url", "")))
    return out


GHOST_AGE_H = 12   # a run still queued/running after this is a GitHub-side ghost (cancel accepted, never applied)


def _ghost_cutoff():
    """Runs created before this are ghosts: cancelling them again only burns the per-tick cancel budget that
    live non-slot runs need (2026-11-19: 30-day-old runs ate all 50 cancels every tick)."""
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() - GHOST_AGE_H * 3600))


# Post-merge bookkeeping that runs when a PR closes and carries no test load: the PR is already gone from the
# queue, so rule 2 would cancel it and the landing note would be lost (ci-enforce.sh, 2026-11-06). "train-content-gate"
# was exempted there too but only matters for merge trains, which are retired, so it is not ported.
# Ported from the retired pr-queue-gate: cheap required-context publishers are never cancelled either. A cancelled
# required check renders as a red X and blocks the merge (#17948 lost "No open blocks-merge issues reference this PR"
# that way, 2026-10-04), and these run for seconds, so cancelling saves nothing. Exact workflow names (a wrong guess
# silently reintroduces that red). The five *-required-context names stop existing at the one-workflow cutover (#18208).
REQUIRED_CONTEXT_PUBLISHERS = {
    "PR Blocking Findings", "No Commit Trailers", "Enforce Pre-commit Hooks", "backend-required-context",
    "code-quality-required-context", "docker-smoke-required-context", "Frontend Required Context",
    "python-required-context"}
PREBOARD_LANE_NAME = "Dispatch Preboard Guards"   # the lane's `name:` in dispatch-preboard-guards.yml, as Actions reports it
# The lane runs on the PR branch, outside the CI slots (#49): rule 2/4 and the degraded tick must never cancel it,
# or every non-slot PR's lane reads as cancelled and burns its retries.
EXEMPT_WORKFLOWS = {"Issue landing notes", PREBOARD_LANE_NAME} | REQUIRED_CONTEXT_PUBLISHERS


def actions_runs():
    runs = []
    for status in ("in_progress", "queued", "waiting", "pending"):
        raw = sh("gh", "api", f"repos/{REPO}/actions/runs?status={status}&per_page=100",
                 "--jq", f'.workflow_runs[]|select(.created_at > "{_ghost_cutoff()}")|[.id,.head_branch,.head_sha,.event,.head_repository.full_name,.name]|@tsv')
        runs += [line.split("\t") for line in raw.splitlines() if line]
    return [r[:5] for r in {r[0]: r for r in runs}.values() if (r[5:6] or [""])[0] not in EXEMPT_WORKFLOWS]   # a run can appear under two status filters


def pr_repo(p):
    """Full name of the repo a PR's head branch lives in (a fork's differs from REPO); "" when the fork is gone."""
    return ((p.get("headRepository") or {}).get("nameWithOwner")) or ""


def is_protected(branch, repo):
    """main/release of THIS repo are protected; a fork's branch of the same name is an ordinary PR head."""
    return branch in PROTECTED and repo in ("", REPO)


def attribute_run(branch, sha, repo, prs):
    """Every open PR a run could belong to. A branch name alone is not an identity (a fork may name its branch like
    an own one), so match (head repo, branch) strictly (a deleted fork is "" on both sides); several candidates
    are narrowed by the run's head SHA."""
    cands = [p for p in prs if p["headRefName"] == branch and pr_repo(p) == repo]
    return [p for p in cands if p["headRefOid"] == sha] or cands if len(cands) > 1 else cands


def classify_run(run, prs, verdict):
    """(PR, reason) for one run. `verdict(p)` is the caller's cancel reason for a PR ("" = keep the run). PR is None
    with reason "protected" (never touched), "ambiguous" (candidate PRs disagree: never act on a guess) or ""
    (no open PR). Candidates that all agree are acted on."""
    _rid, branch, sha, _event, repo = run
    if is_protected(branch, repo):
        return None, "protected"
    cands = attribute_run(branch, sha, repo, prs)
    verdicts = {verdict(p) for p in cands}
    if len(verdicts) > 1:
        return None, "ambiguous"
    return (cands[0], verdicts.pop()) if cands else (None, "")


def sweep_runs(runs, prs, verdict, keep_heads, orphan_reason, log):
    """Cancel runs per `verdict`, once per run id; PR-less runs go unless their (repo, branch) is in keep_heads."""
    for run in runs:
        p, reason = classify_run(run, prs, verdict)
        rid, branch, repo = run[0], run[1], run[4]
        if reason == "protected":
            continue
        if reason == "ambiguous":
            if f"ambiguous:{rid}" not in RECENT:  # say it once per run id (RECENT is persisted for 10 minutes)
                RECENT[f"ambiguous:{rid}"] = time.time()
                log.append(f"run {rid} {repo}:{branch} maps to PRs that disagree: left running")
        elif p is None and (repo, branch) not in keep_heads:
            cancel(rid, branch, "-", orphan_reason, log)
        elif p is not None and reason:
            cancel(rid, branch, p["number"], reason, log)


def _compare_ahead(head):
    """Commits main has beyond `head` (0 when the compare is unreadable)."""
    out = sh("gh", "api", f"repos/{REPO}/compare/{head}...main", "--jq", ".ahead_by").strip()
    return int(out) if out.isdigit() else 0


def fork_stuck_behind(p):
    """A fork head behind main whose author disallows maintainer edits: update-branch cannot fix it, a human must.
    main's protection is not strict, so GitHub never reports BEHIND here: measure it (head...main ahead_by), once per
    PR per tick, and only for the forks we cannot update. BEHIND stays as a shortcut."""
    if not (p.get("isCrossRepository") and not p.get("maintainerCanModify")):
        return False
    if "fork_behind" not in p:
        p["fork_behind"] = p.get("mergeStateStatus") == "BEHIND" or _compare_ahead(p["headRefOid"]) > 0
    return p["fork_behind"]


def fork_runs_await_approval(p):
    """A first-time contributor's runs may create no check runs at all: ask Actions for this head's runs that wait
    for a maintainer's approval (conclusion action_required only: status waiting also covers environment protection)."""
    out = sh("gh", "api", f"repos/{REPO}/actions/runs?head_sha={p['headRefOid']}&per_page=100", "--jq",
             '[.workflow_runs[]|select(.conclusion=="action_required")]|length')
    return out.strip().isdigit() and int(out) > 0


def fork_awaiting_approval(p, red):
    """Every red check of a fork head is ACTION_REQUIRED: the fork's workflow runs await a maintainer approval."""
    return bool(p.get("isCrossRepository") and red and set(red) <= set(p.get("action_required", [])))


def page_manual_sync(n, p, seen, attention):
    """One `needs manual sync` page per head (a fork we cannot update-branch)."""
    k = f"{n}:needs-manual-sync:{p['headRefOid']}"
    if k not in seen:
        seen[k] = int(time.time())
        attention.append({"pr": n, "kind": "needs manual sync", "owner": p["owner"], "owner_state": p["alive"],
                          "branch": p["headRefName"], "head": p["headRefOid"][:9], "title": p["title"][:70]})


def stale_pr_claims(claims, open_nums):
    """Ported from pr-queue-gate: a claim on a PR that is no longer open blocks the next session for no reason,
    and only its owner can release it. Report-only. `claims` is {pr number: owner}."""
    return [f"stale claim: #{n} still held by {o} but the PR is closed/merged; only {o} can release it"
            for n, o in sorted(claims.items()) if n not in open_nums]


def owner_of(r, lg, pr):
    name = r.hget(f"lg:pr:{pr['number']}", "owner") or ""
    if not name and not pr.get("isCrossRepository"):   # claims are keyed by this repo's branch names, never a fork's
        name = (r.hgetall(f"lg:claim:worktree:{pr['headRefName']}") or r.hgetall(
            f"lg:claim:branch:{pr['headRefName']}")).get("owner", "")
    return (name, lg.alive(r, name)) if name else ("-", "unknown")


MAX_CANCELS = 50   # 1 POST/s stays under the ~80/min write limit; 25 could not drain a 175-run queue (2026-11-18)
RECENT = {}   # run id -> epoch of our cancel; a cancelled run stays in_progress for minutes


def cancel(run_id, branch, n, reason, log):
    if time.time() - RECENT.get(run_id, 0) < 600:
        return
    if sum(1 for line in log if line.startswith("cancel ")) >= MAX_CANCELS:
        return                                # secondary rate limit: the rest go next tick
    RECENT[run_id] = time.time()
    log.append(f"cancel run {run_id} #{n}: {reason}")
    if not DRY:
        time.sleep(1)
        sh(str(S / "ci-cancel"), run_id, ME, reason, branch, str(n))


def preboard_failures(res):
    """Names of what failed in a preboard result.json: checks whose status is not a pass, the guard `problems`,
    and the failed tests. The guards check's own status vocabulary is not documented, so only known passes are dropped."""
    checks = res.get("checks") if isinstance(res.get("checks"), dict) else {}
    out = [f"{k}={v.get('status')}" for k, v in checks.items() if isinstance(v, dict) and v.get("status") not in PREBOARD_PASS]
    guards = checks.get("guards") if isinstance(checks.get("guards"), dict) else {}
    out += [str(x) for x in guards.get("problems") or []]
    out += [str(t.get("nodeid")) for t in res.get("failed_tests") or [] if isinstance(t, dict)]
    return (out or [f"overall={res.get('overall')}"])[:PREBOARD_LIST_CAP]


def read_preboard(run_id, head):
    """(state, detail) from a completed lane run's artifact; any failure to read it is "unreadable" (fail closed).
    The base_sha may be stale: the full suite re-checks on the merge ref, so it is deliberately not compared."""
    with tempfile.TemporaryDirectory() as d:
        sh("gh", "run", "download", run_id, "--repo", REPO, "-n", PREBOARD_ARTIFACT, "-D", d)
        try:
            res = json.loads((Path(d) / "result.json").read_text(encoding="utf-8"))
        except (OSError, ValueError) as exc:
            return "unreadable", f"run {run_id}: {PREBOARD_ARTIFACT} not readable ({type(exc).__name__})"
    if not isinstance(res, dict) or not isinstance(res.get("overall"), str):
        return "unreadable", f"run {run_id}: result.json has no `overall`"
    if res.get("sha") != head:
        return "unreadable", f"run {run_id}: result is for another head ({str(res.get('sha'))[:9]})"
    return ("green", "") if res["overall"] in PREBOARD_OK else ("red", preboard_failures(res))


def lane_runs(head):
    """Lane runs for exactly this head, newest first: [(id, status, conclusion)]."""
    out = sh("gh", "api", f"repos/{REPO}/actions/workflows/{PREBOARD_WORKFLOW}/runs?head_sha={head}&event=workflow_dispatch&per_page=5",
             "--jq", '.workflow_runs[]|[.id, .status, (.conclusion // "")]|@tsv')
    return [tuple((ln.split("\t") + ["", ""])[:3]) for ln in out.splitlines() if ln]


def lane_result(runs, head):
    """State of the newest lane run: none | pending | green | red | unreadable, plus a detail."""
    if not runs:
        return "none", ""
    run_id, status, conclusion = runs[0]
    if status != "completed":
        return "pending", ""
    if conclusion == "cancelled":
        return "unreadable", f"run {run_id} was cancelled"
    return read_preboard(run_id, head)


def preboard_dispatch(n, p, seen, log):
    """One dispatch attempt of the lane on the PR branch, at most PREBOARD_MAX_TRIES per head. The marker is set only
    on success. A branch without the workflow or its input is marked unavailable (no more attempts)."""
    head, tk = p["headRefOid"], f"{n}:preboard-tries:{p['headRefOid']}"
    seen[tk] = seen.get(tk, 0) + 1
    rc, err = 0, ""
    if not DRY:
        rc, _out, err = sh_rc("gh", "workflow", "run", PREBOARD_WORKFLOW, "--repo", REPO, "--ref", p["headRefName"], "-f", "base=main")
    if rc and LANE_MISSING.search(err):
        seen[f"{n}:preboard-unavailable:{head}"] = int(time.time())
        log.append(f"#{n} preboard lane unavailable for branch {p['headRefName']} ({err[:160]})")
    elif rc:
        log.append(f"#{n} preboard dispatch failed (exit {rc}, try {seen[tk]}/{PREBOARD_MAX_TRIES}): {err[:200]}")
    else:
        seen[f"{n}:preboard-dispatch:{head}"] = int(time.time())
        log.append(f"#{n} preboard guards: lane dispatched in parallel with the suite (advisory)")


def preboard_note(n, p, seen, log, detail):
    """A lane result we cannot use is logged once per head and pages nobody."""
    k = f"{n}:preboard-lane-note:{p['headRefOid']}"
    if k not in seen:
        seen[k] = int(time.time())
        log.append(f"#{n} preboard lane result not usable (advisory, ignored): {detail}")


def preboard_advisory(n, p, seen, log, attention):
    """The lane is ADVISORY (owner decision): it never gates the suite, a slot, a merge or landing. For a slot PR
    head, dispatch it once alongside the suite; once its result is red, page the owner once per head with
    `guards-advisory`. A broken, cancelled or unreadable result is only logged."""
    head = p["headRefOid"]
    if p.get("isCrossRepository"):
        return                                    # a fork's headRefName is not a ref of this repo: no lane
    if f"{n}:preboard-unavailable:{head}" in seen:
        return
    runs = lane_runs(head)
    if not runs and f"{n}:preboard-dispatch:{head}" not in seen and seen.get(f"{n}:preboard-tries:{head}", 0) < PREBOARD_MAX_TRIES:
        return preboard_dispatch(n, p, seen, log)
    state, detail = lane_result(runs, head)
    if state == "red":
        k = f"{n}:guards-advisory:{head}"
        if k not in seen:
            seen[k] = int(time.time())
            log.append(f"#{n} preboard guards RED at {head[:9]} (advisory): {'; '.join(detail)}")
            attention.append({"pr": n, "kind": "guards-advisory", "advisory": True, "owner": p["owner"], "owner_state": p["alive"],
                              "branch": p["headRefName"], "head": head[:9], "title": p["title"][:70], "checks": detail})
    elif state == "unreadable":
        preboard_note(n, p, seen, log, detail)


def start_ci_or_report(n, p, gate, seen, log, attention):
    """A `[skip ci]` sync head never gets its required checks: ask the sync to start CI once per head (#21577)."""
    parts = gate.split()
    if len(parts) >= 2 and not p["headRefOid"].startswith(parts[1]):
        return                                    # the head moved mid-tick (sync push): next tick sees it
    advisory = json.dumps(sorted(EXEMPT_WORKFLOWS - REQUIRED_CONTEXT_PUBLISHERS))   # advisory lane / notes runs are not "the suite": they must not mask an idle slot
    queued = sh("gh", "api", f"repos/{REPO}/actions/runs?head_sha={p['headRefOid']}&per_page=100",
                "--jq", f'[.workflow_runs[]|select(.status!="completed" and (.name as $n|{advisory}|index($n)|not))]|length')
    if queued not in ("", "0"):                   # a suite run is live (queued or running): CI is underway
        return
    k = f"{n}:start-ci:{p['headRefOid']}"
    msg = sh("gh", "api", f"repos/{REPO}/commits/{p['headRefOid']}", "--jq", ".commit.message")
    if "[skip ci]" in msg and not p.get("isCrossRepository"):   # the sync cannot push to or dispatch for a fork head
        if k not in seen:
            seen[k] = int(time.time())
            log.append(f"start-ci #{n} (head is a [skip ci] sync merge)")
            if not DRY:
                sh("gh", "workflow", "run", "sync-branches-with-main.yml", "--repo", REPO, "-f", f"start_ci_for_pr={n}")
        return
    log.append(f"#{n} slot idle, ci-gate: {gate or 'no answer (rate limit?)'}")
    if not p["total"] and k not in seen:
        seen[k] = int(time.time())
        attention.append({"pr": n, "kind": "no-ci", "owner": p["owner"], "owner_state": p["alive"],
                          "branch": p["headRefName"], "head": p["headRefOid"][:9]})


# ---------------------------------------------------------------------------------------------------------------
# CI dispatch (AutoBot-AI#20825, plan ci-dispatch-plan-2026-11-28): the coordinator STARTS CI for slot PRs with
# workflow_dispatch. DUAL MODE: until main's ci.yml loses `pull_request`, a 422 from the dispatch falls back to the
# legacy path (start_ci_or_report / sync start_ci_for_pr). PR_COORDINATOR_DISPATCH=0 is the kill switch.
# ---------------------------------------------------------------------------------------------------------------
SUITE_WORKFLOWS = ("ci.yml", "no-commit-trailers.yml")            # key: head SHA
META_WORKFLOWS = ("pr-blocking-findings.yml", "pr-template-check.yml",
                  "pr-issue-validation.yml", "pr-structure.yml")  # key: head SHA + metadata digest
FINDINGS_WORKFLOW = "pr-blocking-findings.yml"
DISPATCH_GRACE_SECS = int(os.environ.get("PR_COORDINATOR_DISPATCH_GRACE_SECS", "180"))
DISPATCH_MAX_TRIES = int(os.environ.get("PR_COORDINATOR_DISPATCH_MAX_TRIES", "3"))
FINDINGS_WAIT_SECS = int(os.environ.get("PR_COORDINATOR_FINDINGS_WAIT_SECS", "300"))
LOCK_RETRIES, LOCK_RETRY_SLEEP = 10, 2                              # dispatch_cli waits ~20s for the pass lock
SEEN_MAX_AGE_SECS = 14 * 86400
MIRROR_PREFIX = "ci/pr-"
RUNAWAY_THRESHOLD = int(os.environ.get("PR_COORDINATOR_RUNAWAY_THRESHOLD", "25"))   # pr-queue-gate.yml RUNAWAY_THRESHOLD
NOT_STARTED = {"cancelled", "skipped", "startup_failure"}          # same definition as branch_sync_core.suite_already_started
DISPATCH_UNAVAILABLE = re.compile(r"HTTP 422|HTTP 404|workflow_dispatch|unexpected inputs", re.I)
_CUT, _REDIS = {}, []


def dispatch_enabled():
    return os.environ.get("PR_COORDINATOR_DISPATCH", "1") != "0"


def _trigger_tokens(text):
    """Trigger names under the top-level `on:` key of a workflow file (mapping, list and inline forms)."""
    lines, toks, inside = text.splitlines(), set(), False
    for line in lines:
        bare = re.sub(r"\s+#.*$|^\s*#.*$", "", line).rstrip()
        m = re.match(r"""^["']?(?:on|true)["']?\s*:(.*)$""", bare)
        if m:
            inside = True
            toks |= set(re.findall(r"[A-Za-z_]+", m.group(1)))
            continue
        if inside and bare and not bare[0].isspace():
            inside = False
        if inside:
            m = re.match(r"""^\s*(?:-\s*)?["']?([A-Za-z_]+)["']?\s*(?::.*)?$""", bare)
            if m:
                toks.add(m.group(1))
    return toks


def workflow_cut_over(text):
    """Cutover = the workflow has `workflow_dispatch` and NO `pull_request` / `pull_request_target` trigger."""
    toks = _trigger_tokens(text)
    return "workflow_dispatch" in toks and not toks & {"pull_request", "pull_request_target"}


def cutover_state():
    """Three states of main's ci.yml: True = cut over (workflow_dispatch, no pull_request), False = readable and not
    cut over, None = UNREADABLE (a gh error or an empty body). Callers that gate a merge or a one-time action treat
    None as "do nothing". A readable answer is read once per process; an unreadable one is retried."""
    if "v" not in _CUT:
        rc, out, _ = sh_rc("gh", "api", "-H", "Accept: application/vnd.github.raw",
                           f"repos/{REPO}/contents/.github/workflows/ci.yml?ref=main")
        if rc or not (out or "").strip():
            return None
        _CUT["v"] = workflow_cut_over(out)
    return _CUT["v"]


def cutover_done():
    """True ONLY for a readable, cut-over main ci.yml. Unreadable is not "done" (fail closed)."""
    return cutover_state() is True


def _redis():
    if not _REDIS:
        _REDIS.append(ledger_mod().conn())
    return _REDIS[0]


def fork_approved(n, sha):
    """A human recorded `ledger set <n> --fork-approved <sha>` for exactly this head. Never written by this tool."""
    return bool(sha) and (_redis().hget(f"lg:pr:{n}", "fork_approved") or "") == sha


def dispatch_ref(n, p, seen, log, attention):
    """Branch to dispatch at: the head branch; ci/pr-<n> for an approved fork; "" = not dispatchable (paged)."""
    if p.get("isCrossRepository"):
        return mirror_fork_head(n, p, seen, log, attention)
    return p["headRefName"]


def merge_base(p):
    base = p.get("baseRefName") or "main"
    return sh("gh", "api", f"repos/{REPO}/compare/{base}...{p['headRefOid']}", "--jq", ".merge_base_commit.sha").strip()


def meta_digest(p):
    labels = sorted(l["name"] for l in (p.get("labels") or {}).get("nodes", []) if l["name"] not in (SLOT_LABEL, PARK_LABEL))
    blob = json.dumps([p.get("title", ""), p.get("body") or "", (p.get("milestone") or {}).get("title", ""), labels])
    return hashlib.sha1(blob.encode("utf-8")).hexdigest()[:12]


def dispatch_key(n, wf, sha, digest="", generation=0):
    return f"{n}:dispatch:{wf}:{sha}:{digest}:{generation}"


def dispatched_runs(sha):
    """workflow_dispatch runs at this head (id, path, status, conclusion), or None when unreadable."""
    rc, out, _ = sh_rc("gh", "api", f"repos/{REPO}/actions/runs?head_sha={sha}&event=workflow_dispatch&per_page=100", "--jq",
                       "[.workflow_runs[]|{id,path,status,conclusion,created_at,head_branch}]")
    try:
        return json.loads(out) if rc == 0 else None
    except ValueError:
        return None


def _iso(ts):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts))


def _runs_of(runs, wf):
    return [r for r in runs if (r.get("path") or "").endswith("/" + wf)]


def suite_started(runs, wf):
    return any((r.get("conclusion") or "") not in NOT_STARTED for r in _runs_of(runs, wf))


def _ent_started(ent, runs, wf):
    """The run THIS dispatch created has started: by its recorded run_id, else (no id returned) the workflow's run at
    this head created after the dispatch ts on the dispatched ref. Valid for every generation."""
    mine = _runs_of(runs, wf)
    if ent.get("run_id"):
        cand = [r for r in mine if r.get("id") == ent["run_id"]]
    else:
        since, ref = _iso(ent.get("ts", 0) - 5), ent.get("ref")
        cand = [r for r in mine if (r.get("created_at") or "") >= since and (not ref or r.get("head_branch") in (None, ref))]
    return any((r.get("conclusion") or "") not in NOT_STARTED for r in cand)


def _decide(n, wf, sha, digest, generation, runs, seen, now):
    """'go' | 'skip' | 'page' for one workflow at one head."""
    key = dispatch_key(n, wf, sha, digest, generation)
    mine = _runs_of(runs, wf) if generation == 0 else []
    if any((r.get("conclusion") or "") == "cancelled" for r in mine) and not suite_started(runs, wf):
        return "skip"                                 # a cancelled run is the rerun path's, not a lost dispatch
    ent = seen.get(key)
    if not isinstance(ent, dict):
        other = any(k.startswith(f"{n}:dispatch:{wf}:{sha}:") and k != key for k in seen)
        if generation == 0 and suite_started(runs, wf) and not (digest and other):
            seen[key] = {"ts": now, "run_id": (mine[-1] or {}).get("id"), "tries": 0}   # state lost: adopt, never double
            return "skip"
        return "go"
    if (suite_started(runs, wf) and generation == 0) or _ent_started(ent, runs, wf) \
            or now - ent.get("ts", 0) < DISPATCH_GRACE_SECS:
        return "skip"
    return "go" if ent.get("tries", 1) < DISPATCH_MAX_TRIES else "page"


def dispatch_workflow(n, p, wf, ref, key, base, digest, seen, log, attention):
    """One POST .../dispatches. Returns 'ok' | 'unavailable' (422/404) | 'error'. Key written only on success."""
    sha = p["headRefOid"]
    log.append(f"dispatch #{n} {wf} @ {ref} ({sha[:9]})")
    if DRY:
        return "ok"
    rc, out, err = sh_rc("gh", "api", "-X", "POST", f"repos/{REPO}/actions/workflows/{wf}/dispatches", "-f", f"ref={ref}",
                         "-f", f"inputs[pr_number]={n}", "-f", f"inputs[head_sha]={sha}", "-f", f"inputs[base_sha]={base}")
    if rc:
        if DISPATCH_UNAVAILABLE.search(err):
            return "unavailable"
        log.append(f"ATTENTION #{n} dispatch {wf} failed rc={rc}: {err[:120]}")
        return "error"
    try:
        run_id = json.loads(out).get("workflow_run_id") if out else None
    except ValueError:
        run_id = None
    prev = seen.get(key) if isinstance(seen.get(key), dict) else {}
    seen[key] = {"ts": int(time.time()), "run_id": run_id, "ref": ref, "tries": prev.get("tries", 0) + 1}
    return "ok"


def _sync_head(n, p, log, attention, seen):
    """Merge main into the head (Q2: test the head == the merge result)."""
    if p.get("isCrossRepository") and not p.get("maintainerCanModify"):
        page_manual_sync(n, p, seen, attention)
        return
    log.append(f"update-branch #{n} (behind main: sync before dispatch)")
    if not DRY:
        sh("gh", "api", "-X", "PUT", f"repos/{REPO}/pulls/{n}/update-branch", "-f", f"expected_head_sha={p['headRefOid']}")


def ref_dispatchable(n, p, seen):
    """Dual mode: dispatch only when the head's own ci.yml is cut over (workflow_dispatch AND no pull_request /
    pull_request_target), else its events would run the suite a second time. Memoised per head, with a timestamp."""
    k = f"{n}:ref-dispatchable:{p['headRefOid']}"
    if not isinstance(seen.get(k), dict):
        rc, out, _ = sh_rc("gh", "api", "-H", "Accept: application/vnd.github.raw",
                           f"repos/{REPO}/contents/.github/workflows/ci.yml?ref={p['headRefOid']}")
        if rc:
            return False
        seen[k] = {"ok": workflow_cut_over(out), "ts": int(time.time())}
    return bool(seen[k]["ok"])


def _page_once(n, p, kind, key, seen, attention, **extra):
    k = f"{n}:{kind}:{key}"
    if k not in seen:
        seen[k] = int(time.time())
        attention.append({"pr": n, "kind": kind, "owner": p.get("owner"), "owner_state": p.get("alive"),
                          "branch": p.get("headRefName"), "head": p["headRefOid"][:9], **extra})


def _unavailable(n, p, seen, log, attention):
    """ci.yml cannot be dispatched at this head. Before cutover the legacy events still run: legacy path (False).
    After it nothing else can start CI: sync a behind head (new head carries the inputs), else page."""
    sha = p["headRefOid"]
    seen[f"{n}:dispatch-unavailable:{sha}"] = int(time.time())
    log.append(f"dispatch #{n} unavailable at {sha[:9]} (no workflow_dispatch inputs on that ref)")
    cut = cutover_state()
    if cut is None:
        log.append(f"dispatch #{n}: main ci.yml unreadable, doing nothing this tick")
        return True
    if not cut:
        return False
    if _compare_ahead(sha) > 0:
        _sync_head(n, p, log, attention, seen)
    else:
        _page_once(n, p, "no-ci", f"undispatchable:{sha}", seen, attention, reason="dispatch refused (422) and no event can start CI")
    return True


def dispatch_ci(n, p, seen, log, attention, generation=0):
    """The single entry point. True = the dispatch path owns CI for this PR (legacy starters must stay quiet);
    False = use the legacy path (kill switch, dispatch unavailable before cutover, fork without approval before cutover)."""
    sha, cut = p["headRefOid"], cutover_state()
    if not dispatch_enabled() or f"{n}:dispatch-unavailable:{sha}" in seen:
        return False
    if cut is None:
        log.append(f"dispatch #{n}: main ci.yml unreadable, doing nothing this tick")
        return True                                   # unknown cutover: neither dispatch nor start a legacy run
    if p.get("isCrossRepository") and not cut and not fork_approved(n, sha):
        return False                                  # forks keep their approval-gated event runs until cutover
    ref = dispatch_ref(n, p, seen, log, attention)
    if not ref:
        return True
    if not cut and not ref_dispatchable(n, p, seen):
        return False                                  # dual mode: the head has no dispatch inputs yet, events run it
    if _compare_ahead(sha) > 0:
        _sync_head(n, p, log, attention, seen)
        return True
    live = sh("gh", "api", f"repos/{REPO}/pulls/{n}", "--jq", ".head.sha").strip()
    if live and live != sha:
        log.append(f"dispatch #{n}: head moved ({sha[:9]} -> {live[:9]}), next tick")
        return True
    base = merge_base(p)
    if not base:
        log.append(f"dispatch #{n}: merge base unreadable, retry next tick")
        return True
    runs = dispatched_runs(sha)
    if runs is None:
        log.append(f"dispatch #{n}: run list unreadable, retry next tick")
        return True
    return _dispatch_all(n, p, ref, base, runs, generation, seen, log, attention)


def _dispatch_all(n, p, ref, base, runs, generation, seen, log, attention):
    sha, digest, now = p["headRefOid"], meta_digest(p), int(time.time())
    for wf in SUITE_WORKFLOWS + META_WORKFLOWS:
        dg = digest if wf in META_WORKFLOWS else ""
        key = dispatch_key(n, wf, sha, dg, generation)
        verdict = _decide(n, wf, sha, dg, generation, runs, seen, now)
        if verdict == "page":
            _page_once(n, p, "no-ci", f"lost-dispatch:{wf}:{sha}", seen, attention, workflow=wf, tries=DISPATCH_MAX_TRIES)
        if verdict != "go":
            continue
        res = dispatch_workflow(n, p, wf, ref, key, base, dg, seen, log, attention)
        if res == "unavailable" and wf == SUITE_WORKFLOWS[0]:
            return _unavailable(n, p, seen, log, attention)
        if res == "unavailable":
            _page_once(n, p, "dispatch-unavailable", f"{wf}:{sha}", seen, attention, workflow=wf)
    return True


def mirror_fork_head(n, p, seen, log, attention):
    """Mirror a fork head to ci/pr-<n> at the SAME sha, ONLY with a recorded human approval of that exact sha
    (`ledger set <n> --fork-approved <sha>`). Without one: ATTENTION, no mirror, no dispatch. Never approves itself."""
    sha, ref = p["headRefOid"], f"{MIRROR_PREFIX}{n}"
    if not fork_approved(n, sha):
        _page_once(n, p, "fork-approval", f"ci:{sha}", seen, attention,
                   detail=f"fork head {sha[:9]} awaits owner approval to run with repo secrets")
        return ""
    k = f"{n}:fork-mirror:{sha}"
    if k in seen and _mirror_sha(ref) == sha:
        return ref                                    # trust the key only while the ref still carries this sha
    seen.pop(k, None)
    log.append(f"mirror fork head #{n} -> {ref} @ {sha[:9]}")
    if DRY:
        return ref
    rc, _, err = sh_rc("gh", "api", "-X", "POST", f"repos/{REPO}/git/refs", "-f", f"ref=refs/heads/{ref}", "-f", f"sha={sha}")
    if rc and "already exists" in err:
        rc, _, err = sh_rc("gh", "api", "-X", "PATCH", f"repos/{REPO}/git/refs/heads/{ref}", "-f", f"sha={sha}", "-F", "force=true")
    if rc:
        log.append(f"ATTENTION #{n} mirror {ref} failed rc={rc}: {err[:120]}")
        attention.append({"pr": n, "kind": "gh-failed", "step": "mirror fork head", "rc": rc, "head": sha[:9]})
        return ""
    seen[k] = int(time.time())
    return ref


def _mirror_sha(ref):
    """Current sha of refs/heads/<ref>, "" when missing or unreadable."""
    rc, out, _ = sh_rc("gh", "api", f"repos/{REPO}/git/ref/heads/{ref}", "--jq", ".object.sha")
    return out.strip() if rc == 0 else ""


def mirror_keep_heads(prs, slots):
    return {(REPO, f"{MIRROR_PREFIX}{p['number']}") for p in prs if p["number"] in slots and p.get("isCrossRepository")}


def mirror_cleanup(prs, slots, log, seen=None):
    """Delete ci/pr-<n> mirrors whose PR is gone, holds no slot, or whose head moved (they are refs we created)."""
    want = {f"{MIRROR_PREFIX}{p['number']}": p["headRefOid"] for p in prs if p["number"] in slots and p.get("isCrossRepository")}
    out = sh("gh", "api", f"repos/{REPO}/git/matching-refs/heads/{MIRROR_PREFIX}", "--jq", '.[]|"\\(.ref) \\(.object.sha)"')
    for line in out.splitlines():
        ref, _, sha = line.partition(" ")
        short = ref.removeprefix("refs/heads/")
        if short.startswith(MIRROR_PREFIX) and want.get(short) != sha:
            log.append(f"delete mirror {short}")
            if not DRY:
                sh("gh", "api", "-X", "DELETE", f"repos/{REPO}/git/refs/heads/{short}")
            if seen is not None:
                for k in [k for k in seen if k.startswith(f"{short.removeprefix(MIRROR_PREFIX)}:fork-mirror:")]:
                    del seen[k]


def prune_seen(seen, now=None):
    """Drop notified.json keys older than 14 days: dispatch records, ref-dispatchable memos and per-day keys."""
    cut = int(now or time.time()) - SEEN_MAX_AGE_SECS
    for k, v in list(seen.items()):
        if ":dispatch:" in k or ":ref-dispatchable:" in k:
            ts = v.get("ts") if isinstance(v, dict) else None
            if not isinstance(ts, (int, float)) or ts < cut:
                del seen[k]
        elif re.match(r"^queue-runaway:\d{4}-\d{2}-\d{2}$", k):
            if not isinstance(v, (int, float)) or v < cut:
                del seen[k]


def runaway_page(prs, seen, attention):
    """Q6: the open-PR count reached pr-queue-gate's runaway threshold (a detector, not a cap). Once per day."""
    k = f"queue-runaway:{time.strftime('%F')}"
    if len(prs) >= RUNAWAY_THRESHOLD and k not in seen:
        seen[k] = int(time.time())
        attention.append({"pr": None, "kind": "pr-queue-runaway", "open": len(prs), "threshold": RUNAWAY_THRESHOLD})


def is_external(p):
    """External contributor: a fork head or an author other than the repo owner. Only these need a ledger approve."""
    author = ((p.get("author") or {}).get("login")) or ""
    return bool(p.get("isCrossRepository")) or author != REPO.split("/")[0]


def fetch_pr_rest(n):
    """One PR in the shape of fetch_prs (the fields dispatch needs), via REST, for the one-PR CLI paths."""
    out = sh("gh", "api", f"repos/{REPO}/pulls/{n}", "--jq",
             '{number,title,body,isDraft:.draft,headRefName:.head.ref,headRefOid:.head.sha,baseRefName:.base.ref,'
             'headRepository:{nameWithOwner:(.head.repo.full_name // "")},isCrossRepository:(.head.repo.full_name != .base.repo.full_name),'
             'maintainerCanModify:.maintainer_can_modify,milestone:(if .milestone then {title:.milestone.title} else null end),'
             'author:{login:.user.login},labels:{nodes:[.labels[]|{name}]},state}')
    try:
        p = json.loads(out)
    except ValueError:
        return None
    return p if p.get("state") == "open" else None


def dispatch_cli(n):
    """`--dispatch PR`: one-PR dispatch pass under the pass lock (push-and-park calls it right after a push).
    0 = done / nothing to do, 3 = refused (no slot), 1 = error."""
    lock = take_pass_lock()
    for _ in range(LOCK_RETRIES if lock is None else 0):
        time.sleep(LOCK_RETRY_SLEEP)
        if (lock := take_pass_lock()) is not None:
            break
    if lock is None:
        print(f"#{n}: coordinator pass lock still held after {LOCK_RETRIES * LOCK_RETRY_SLEEP}s; nothing dispatched, retry")
        return 1
    try:
        r = _redis()
        if not r.exists(f"lg:hold:ci-slot:{n}"):
            print(f"#{n} holds no CI slot: nothing dispatched")
            return 3
        p = fetch_pr_rest(n)
        if not p:
            print(f"#{n} is not an open PR")
            return 1
        p["owner"], p["alive"] = owner_of(r, ledger_mod(), p)
        STATE.mkdir(parents=True, exist_ok=True)
        seen_path = STATE / "notified.json"
        seen = json.loads(seen_path.read_text(encoding="utf-8")) if seen_path.exists() else {}
        log, attention = [], []
        reason = proof_status(p, seen)
        if reason:
            print(f"#{n} barred by the requirement-proof gate: {reason}")
            return 0
        owned = dispatch_ci(n, p, seen, log, attention)
        print("\n".join(f"ACTION {l}" for l in log) or f"#{n}: nothing to dispatch")
        print("dispatch path" if owned else "legacy path (dispatch unavailable)")
        prune_seen(seen)
        write_atomic(seen_path, json.dumps(seen))
        if attention:
            with open(STATE / "attention.jsonl", "a", encoding="utf-8") as fh:
                fh.writelines(json.dumps({"ts": int(time.time()), **a}) + "\n" for a in attention)
        return 0
    finally:
        lock.close()


def findings_gate_cli(n):
    """`--findings-gate PR` (safe-merge, immediately before the merge): dispatch pr-blocking-findings.yml for the head
    and wait for its conclusion (bounded). 0 = success, 1 = failed / timed out / cannot run, 3 = not applicable
    (dual mode before cutover, or the kill switch): the caller keeps today's behaviour."""
    if not dispatch_enabled():
        print("findings gate not applicable (dispatch disabled)")
        return 3
    cut = cutover_state()
    if cut is None:
        print(f"#{n} findings gate cannot run: main ci.yml unreadable (no merge)")
        return 1
    if not cut:
        print("findings gate not applicable (dual mode before cutover)")
        return 3
    p = fetch_pr_rest(n)
    if not p:
        print(f"#{n} is not an open PR")
        return 1
    seen, log, att = {}, [], []
    ref = p["headRefName"] if not p.get("isCrossRepository") else (f"{MIRROR_PREFIX}{n}" if fork_approved(n, p["headRefOid"]) else "")
    base = merge_base(p)
    if not ref or not base:
        print(f"#{n} findings gate cannot run (no dispatchable ref or merge base)")
        return 1
    t0 = time.time()
    res = dispatch_workflow(n, p, FINDINGS_WORKFLOW, ref, "k", base, "", seen, log, att)
    if res != "ok":
        print(f"#{n} findings dispatch {res}")
        return 1
    return _wait_findings(n, p["headRefOid"], t0, (seen.get("k") or {}).get("run_id"))


def _wait_findings(n, sha, t0, run_id=None):
    """Wait for THE run this gate dispatched (by id), else the newest findings run at this head created after t0."""
    deadline = time.time() + FINDINGS_WAIT_SECS
    while time.time() < deadline:
        runs = [r for r in (dispatched_runs(sha) or []) if (r.get("path") or "").endswith("/" + FINDINGS_WORKFLOW)
                and r.get("created_at", "9") >= _iso(t0 - 5)]
        if run_id:
            runs = [r for r in runs if r.get("id") == run_id] or runs
        newest = max(runs, key=lambda r: r.get("created_at", ""), default=None)
        if newest and newest.get("status") == "completed":
            concl = newest.get("conclusion")
            print(f"#{n} findings gate: {concl}")
            return 0 if concl == "success" else 1
        time.sleep(10)
    print(f"#{n} findings gate: no conclusion within {FINDINGS_WAIT_SECS}s")
    return 1


def merges_only_main(others):
    """A merge brings in only main when every non-first parent is already in main. Judged by ancestry,
    not by the commit title: sync bot, update-branch and hand merges word it three different ways."""
    for sha in others:
        status = sh("gh", "api", f"repos/{REPO}/compare/{sha}...main", "--jq", ".status")
        if status not in ("ahead", "identical"):
            return False
    return True


CELL_SPLIT = re.compile(r"(?<!\\)\|")
FENCE = re.compile(r"^\s*(```|~~~)")
WALK_LIMIT = 40   # first-parent steps when looking for the newest non-main-merge commit


def _cells(line):
    """Cells of one table row: split on unescaped pipes, `\\|` unescaped to `|`."""
    inner = line.strip()
    inner = inner[1:] if inner.startswith("|") else inner
    inner = inner[:-1] if inner.endswith("|") and not inner.endswith("\\|") else inner
    return [c.strip().replace("\\|", "|") for c in CELL_SPLIT.split(inner)]


def _table_after_heading(body):
    """Table lines of the `## Requirement proofs` section (fenced code is not a heading or a table), or None
    without the heading. Non-table lines before the first `|` line are skipped; the section ends at the next
    level 1-3 heading. An empty list means the section holds no table."""
    lines, fenced, start = (body or "").splitlines(), False, None
    section = []
    for ln in lines:
        if FENCE.match(ln):
            fenced = not fenced
            continue
        if fenced:
            continue
        t = ln.strip()
        if start is None:
            if re.fullmatch(r"#{2,}\s*requirement\s+proofs\s*", t, re.I):
                start = True
            continue
        if re.match(r"#{1,3}\s", t):
            break
        section.append(t)
    if start is None:
        return None
    first = next((j for j, x in enumerate(section) if x.startswith("|")), None)
    if first is None:
        return []
    rest = section[first:]
    return rest[:next((j for j, x in enumerate(rest) if not x.startswith("|")), len(rest))]


def _header_name(cell):
    """Normalised header cell: one trailing parenthetical note stripped, lower-cased, spaces collapsed."""
    return re.sub(r"\s+", " ", re.sub(r"\s*\([^)]*\)\s*$", "", cell).lower()).strip()


def proof_table_reason(body):
    """Empty string when the PR body holds a valid requirement-proof table, else the reason it is not."""
    table = _table_after_heading(body)
    if table is None:
        return "no '## Requirement proofs' heading"
    if not table:
        return "no table under the '## Requirement proofs' heading"
    if len(table) < 2 or [_header_name(c) for c in _cells(table[0])] != PROOF_COLUMNS:
        return "table header is not AC | Precondition | Postcondition | Establishing lines | Argument | Reviewer"
    sep = _cells(table[1])
    if len(sep) != len(PROOF_COLUMNS) or not all(re.fullmatch(r":?-+:?", c.replace(" ", "")) for c in sep):
        return "table separator row is not 6 cells of dashes"
    if len(table) == 2:
        return "table has no data row"
    for k, row in enumerate(table[2:], 1):
        cells = _cells(row)
        if len(cells) != len(PROOF_COLUMNS) or not all(cells):
            return f"row {k} has an empty cell or the wrong cell count"
        if cells[-1].lower() in UNSIGNED_REVIEWER:
            return f"row {k}: Reviewer not signed"
        if not reviewer_verdict_ok(cells[-1]):
            return f"row {k}: Reviewer verdict is not 'holds'"
    return ""


def _ts(text):
    """ISO-8601 to an aware datetime; `Z` and `+00:00` spell the same instant."""
    return datetime.datetime.fromisoformat(text.strip().replace("Z", "+00:00"))


START_CI_SUBJECT = "chore(ci): start the suite on the synced head"   # subject of the coordinator's own start-CI commit


def _commit_facts(sha):
    raw = sh("gh", "api", f"repos/{REPO}/commits/{sha}",
             "--jq", '[.sha, (.parents|map(.sha)|join(",")), .commit.committer.date, .commit.tree.sha, '
                     '(.commit.message|split("\n")[0])]|@tsv')
    return raw.split("\t") if raw.count("\t") == 4 else None


def _is_start_ci_commit(parents, tree, subject):
    """The coordinator's own empty start-CI commit: single parent, tree equal to the parent's, AND the subject.
    Never the subject alone, so a real commit cannot fake it. None (unreadable) is treated as not skipped."""
    if len(parents) != 1 or not subject.startswith(START_CI_SUBJECT):
        return False
    parent_tree = sh("gh", "api", f"repos/{REPO}/commits/{parents[0]}", "--jq", ".commit.tree.sha")
    return bool(parent_tree) and parent_tree.strip() == tree


def effective_push(head):
    """(sha, committer date) of the newest commit that is NOT a merge of main or the coordinator's empty start-CI
    commit, walking first parents. A merge
    of main (two parents, every later parent already in main: the coordinator's update-branch, the sync bot,
    a hand merge) is not a new push, so an exempt PR stays exempt through its syncs."""
    cur = head
    for _ in range(WALK_LIMIT):
        facts = _commit_facts(cur)
        if not facts:
            return None
        sha, parents, date, tree, subject = facts
        parents = parents.split(",")
        if len(parents) == 1 and _is_start_ci_commit(parents, tree, subject):
            cur = parents[0]
            continue
        if not (len(parents) >= 2 and merges_only_main(parents[1:])):
            return sha, date
        cur = parents[0]
    return None


def _force_push_times(n):
    """(ok, [created_at...]) of the PR's head_ref_force_pushed events; ok is False on an API error."""
    proc = subprocess.run(["gh", "api", f"repos/{REPO}/issues/{n}/timeline?per_page=100", "--paginate", "--jq",
                           '.[]|select(.event=="head_ref_force_pushed")|.created_at'],
                          capture_output=True, text=True, encoding="utf-8")
    return proc.returncode == 0, proc.stdout.split()


def head_is_exempt(p):
    """True/False, or None when the answer could not be read (fail closed: None is NOT exempt, never cached).
    Exempt = the pushed work is at or before the cutoff. Push time is the later of the effective head's
    committer date and the PR timeline's latest head_ref_force_pushed event: neither alone is a push time
    (a plain push has no timeline event; a commit made earlier keeps its old committer date). A PR created
    after the cutoff is never exempt."""
    cutoff = _ts(PROOF_CUTOFF)
    if p.get("createdAt") and _ts(p["createdAt"]) > cutoff:
        return False
    eff = effective_push(p["headRefOid"])
    ok, force = _force_push_times(p["number"])
    if not eff or not ok:
        return None
    return max(_ts(t) for t in [eff[1]] + force[-1:]) <= cutoff


def proof_status(p, seen=None):
    """Empty string when CI may start for this head; else why not (requirement-proof gate, owner 2026-11-23).
    The exemption verdict is persisted per (PR, head) in `seen` (notified.json) so the commit and timeline API
    calls are made once per head, not every tick."""
    reason = proof_table_reason(p.get("body"))
    if not reason:
        return ""
    seen = {} if seen is None else seen
    key = f"{p['number']}:proof-exempt:{p['headRefOid']}"
    if key not in seen:
        verdict = head_is_exempt(p)
        if verdict is None:
            return reason + " (exemption unreadable, failing closed)"
        seen[key] = int(verdict)
    return "" if seen[key] else reason


def proof_blocked(p, seen, log, attention):
    """True (and reported once per head) when the proof gate bars CI. The PR keeps its FIFO place."""
    reason = proof_status(p, seen)
    if not reason:
        return False
    k = f"{p['number']}:proof-missing:{p['headRefOid']}"
    if k not in seen:
        seen[k] = int(time.time())
        log.append(f"#{p['number']} blocked: requirement-proof table missing/invalid ({reason})")
        attention.append({"pr": p["number"], "kind": "proof-missing", "owner": p.get("owner"), "owner_state": p.get("alive"),
                          "branch": p["headRefName"], "head": p["headRefOid"][:9], "reason": reason})
    return True


def proof_check_cli(n):
    """`pr-coordinator --proof-check N`: exit 0 = CI may start, 1 = barred (reason on stderr). Shared by
    safe-merge and branch-refresh so the parser lives only here."""
    raw = sh("gh", "api", f"repos/{REPO}/pulls/{n}", "--jq",
             '{number, headRefOid: .head.sha, headRefName: .head.ref, body, createdAt: .created_at}')
    if not raw:
        print(f"#{n}: PR unreadable, failing closed", file=sys.stderr)
        return 1
    reason = proof_status(json.loads(raw))
    if reason:
        print(f"#{n}: requirement-proof table missing/invalid ({reason})", file=sys.stderr)
    return 1 if reason else 0


def review_carries(review_sha, head, pr=None):
    """Owner 2026-11-18: an approval carries across auto-sync merges of main and empty start-CI commits (first-parent
    walk, the fast path). Owner 2026-11-28 ("quality only"): it also carries when the PR's own diff is unchanged
    (same sha256 over the raw `git diff --binary` against each head's own merge-base with main), whatever merges moved the head."""
    if not review_sha:
        return False
    if head.startswith(review_sha) or _walk_carries(review_sha, head):
        return True
    return _same_patch(review_sha, head, pr)


def _walk_carries(review_sha, head):
    cur = head                                # walk FIRST parents only: main's commits merged in are not the PR's
    for _ in range(40):
        if cur.startswith(review_sha) or review_sha.startswith(cur):
            return True
        raw = sh("gh", "api", f"repos/{REPO}/commits/{cur}",
                 "--jq", '[.sha, (.parents|map(.sha)|join(",")), (.files|length), (.commit.message|split("\n")[0])]|@tsv')
        if not raw:
            return False
        sha, parents, nfiles, subject = raw.split("\t", 3)
        parents = parents.split(",")
        ok = (len(parents) >= 2 and merges_only_main(parents[1:])) or (len(parents) == 1 and nfiles == "0")
        if not ok:
            return False
        cur = parents[0]
    return False


PATCH_GIT = STATE / "patchid.git"           # bare cache clone: holds the commits whose diffs we compare
PATCH_CACHE = STATE / "patchid-cache.json"  # "sha:merge_base" -> sha256 of the normalised diff; both ends are immutable
PATCH_LOCK = STATE / "patchid.lock"         # flock: serialises only the cache read-modify-write, never a fetch
PATCH_LOCK_WAIT = 5.0                       # seconds of LOCK_NB retries before failing closed
PATCH_TMP_MAX_AGE = 3600
PATCH_TIMEOUT = int(os.environ.get("PR_COORDINATOR_PATCH_TIMEOUT", "120"))
PATCH_CACHE_MAX_AGE = 14 * 86400
PATCH_CACHE_MAX_ENTRIES = 2000
PATCH_GC_EVERY = 50                         # `git gc --auto` once per this many cache writes
_MAIN_FETCHED = []


def _plog(msg):
    print(f"review_carries: {msg}", file=sys.stderr)


def _pgit(*args, stdin=None):
    """Bytes in, bytes out; a hang or a missing git is an rc!=0 result, never an exception."""
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    try:
        p = subprocess.run(["git", "--git-dir", str(PATCH_GIT), *args], input=stdin, capture_output=True, env=env,
                           timeout=PATCH_TIMEOUT)
    except (subprocess.TimeoutExpired, OSError) as e:
        return 1, b"", f"{type(e).__name__}: {e}".encode()
    return p.returncode, p.stdout, p.stderr


def _have_commit(sha):
    return PATCH_GIT.exists() and _pgit("cat-file", "-e", f"{sha}^{{commit}}")[0] == 0


def _pgit_ok(what, *args):
    rc, _, err = _pgit(*args)
    if rc:
        _plog(f"{what} failed (rc {rc}): {err.decode('utf-8', 'replace').strip()[:200]}")
    return rc == 0


def _init_clone():
    if (PATCH_GIT / "HEAD").exists():
        return True
    PATCH_GIT.parent.mkdir(parents=True, exist_ok=True)
    return (_pgit_ok("git init", "init", "--bare", "-q")
            and _pgit_ok("git remote add", "remote", "add", "origin", f"https://github.com/{REPO}.git"))


def _fetch_commit(sha, pr=None):
    """Make `sha` and CURRENT main available locally. False = unavailable: callers fail closed (never a stale main)."""
    if not _init_clone():
        return False
    cred = ["-c", "credential.helper=!gh auth git-credential"]
    if not _MAIN_FETCHED:
        if not _pgit_ok("fetch main", *cred, "fetch", "-q", "--no-tags", "origin", "+refs/heads/main:refs/remotes/origin/main"):
            return False
        _MAIN_FETCHED.append(1)
    if not _have_commit(sha):
        if pr:                                # the PR head ref also covers fork heads
            _pgit_ok(f"fetch refs/pull/{pr}/head", *cred, "fetch", "-q", "--no-tags", "origin", f"+refs/pull/{pr}/head:refs/remotes/origin/pr/{pr}")
        if not _have_commit(sha):             # an older head (the reviewed one) is not under the PR ref after a push
            _pgit_ok(f"fetch {sha[:10]}", *cred, "fetch", "-q", "--no-tags", "origin", sha)
    return _have_commit(sha) and _pgit("rev-parse", "--verify", "-q", "refs/remotes/origin/main")[0] == 0


def _cache_load():
    try:
        data = json.loads(PATCH_CACHE.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):             # absent or corrupt: empty, it is only a cache
        return {}


def _cache_store(cache):
    now = time.time()
    live = {k: v for k, v in cache.items() if isinstance(v, dict) and now - v.get("t", 0) < PATCH_CACHE_MAX_AGE}
    for k in sorted(live, key=lambda k: live[k]["t"], reverse=True)[PATCH_CACHE_MAX_ENTRIES:]:
        del live[k]
    tmp = PATCH_CACHE.with_name(f"{PATCH_CACHE.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(live), encoding="utf-8")
    os.replace(tmp, PATCH_CACHE)
    for old in PATCH_CACHE.parent.glob(f"{PATCH_CACHE.name}.*.tmp"):
        try:
            if now - old.stat().st_mtime > PATCH_TMP_MAX_AGE:
                old.unlink()
        except OSError:
            pass
    if len(live) % PATCH_GC_EVERY == 0:
        _pgit("gc", "--auto", "-q")


def _normalise_diff(diff):
    """Drop what main can change under an identical PR change: `index <old>..<new>` blob ids and the numbers and
    section text of `@@` headers. Every other byte stays (+/-/context lines, modes, renames, binary payloads)."""
    out = []
    for line in diff.split(b"\n"):
        if line.startswith(b"index "):
            continue
        out.append(b"@@" if line.startswith(b"@@ ") else line)
    return b"\n".join(out)


class _PatchLock:
    """Non-blocking flock with a short bounded retry; `.held` False = busy, the caller fails closed."""
    def __init__(self):
        PATCH_LOCK.parent.mkdir(parents=True, exist_ok=True)
        self.fh, self.held = open(PATCH_LOCK, "a+"), False
        deadline = time.monotonic() + PATCH_LOCK_WAIT
        while True:
            try:
                fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                self.held = True
                return
            except OSError:
                if time.monotonic() >= deadline:
                    return
                time.sleep(0.1)

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.fh.close()                       # closing releases the flock


def _cached_id(key):
    """(busy, id): the lock covers only the cache read."""
    with _PatchLock() as lk:
        if not lk.held:
            return True, ""
        entry = _cache_load().get(key)
        return False, entry["id"] if isinstance(entry, dict) and entry.get("id") else ""


def _store_id(key, diff_id):
    with _PatchLock() as lk:
        if not lk.held:
            return False
        cache = _cache_load()
        cache[key] = {"id": diff_id, "t": time.time()}
        _cache_store(cache)
        return True


def _diff_id(sha, pr=None):
    """sha256 over the normalised diff of the PR's own change (merge-base..sha); see _normalise_diff. Whitespace
    and binary content still count. Network fetches run outside the lock. "" = unavailable, empty or the lock
    busy: never carry."""
    if not _fetch_commit(sha, pr):
        return ""
    rc, base, _ = _pgit("merge-base", "refs/remotes/origin/main", sha)
    base = base.decode("ascii", "replace").strip()
    if rc or not base:
        return ""
    key = f"{sha}:{base}"
    busy, cached = _cached_id(key)
    if busy or cached:
        return cached
    rc, diff, _ = _pgit("diff", "--no-color", "--binary", "--full-index", base, sha)
    if rc or not diff:
        return ""                             # empty diff: nothing to compare
    diff_id = hashlib.sha256(_normalise_diff(diff)).hexdigest()
    return diff_id if _store_id(key, diff_id) else ""


def _same_patch(review_sha, head, pr=None):
    try:
        full = sh("gh", "api", f"repos/{REPO}/commits/{review_sha}", "--jq", ".sha")   # the review sha may be abbreviated
        if not full:
            return False
        old, new = _diff_id(full, pr), _diff_id(head, pr)
        return bool(old) and old == new
    except Exception as e:                    # a tick must never abort on the carry path: fail closed
        _plog(f"failing closed on {type(e).__name__}: {str(e)[:200]}")
        return False


# A red check whose log tail holds one of these is runner infrastructure, not code: it is re-run once per
# (PR, head, job) instead of paging (#35). Keep every pattern specific: never a bare "error" or "timeout".
INFRA_PATTERNS = [re.compile(x) for x in (
    r"Temporary failure (resolving|in name resolution)", r"Could not resolve (host|')", r"Unable to find the server at",
    r"getaddrinfo EAI_AGAIN", r"E: Failed to fetch https?://", r"Unable to fetch some archives",
    r"The runner has received a shutdown signal", r"runner .{0,60}lost communication with the server",
    r"No space left on device", r"Failed to download action", r"Unable to resolve action",
    r"Failed to connect to \S+ port \d+.*(timed out|Connection refused|Could not connect to server)",
    r"unable to access '[^']*':.*Could not connect to server", r"RPC failed; curl \d+",
    r"protocol error: bad pack header", r"fatal: .*Connection reset by peer")]
# Test-failure evidence anywhere in the tail vetoes an infra verdict.
CODE_FAILURE = re.compile(r"^FAILED \S+::|\b\d+ failed\b|AssertionError|No export is defined on the .* mock|error TS\d+|"
                          r"Test Files +\d+ failed|Tests +\d+ failed|^E {3}", re.M)
LOG_TAIL_LINES = 200


def clean_log(raw):
    """Last LOG_TAIL_LINES lines of a job log, without ANSI escapes or the per-line timestamp prefix."""
    lines = [re.sub(r"^\d{4}-\d\d-\d\dT[\d:.]+Z ", "", re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", x)) for x in raw.splitlines()]
    return "\n".join(lines[-LOG_TAIL_LINES:])


def log_tail(job_id):
    return clean_log(sh("gh", "api", "--allow-escape-sequences", f"repos/{REPO}/actions/jobs/{job_id}/logs"))


def is_infra_failure(tail):
    """True when the log tail shows a runner/network failure and no test-failure evidence."""
    return bool(tail) and not CODE_FAILURE.search(tail) and any(x.search(tail) for x in INFRA_PATTERNS)


def infra_rerun(p, seen, log):
    """Rule 4 filter: when EVERY red check of this PR failed on infrastructure and none was re-run at this head
    yet, re-run the failed jobs once and report no red. Otherwise return the red names unchanged."""
    n, head, red = p["number"], p["headRefOid"], p["red"]
    keys = {c: f"{n}:infra-rerun:{head}:{c}" for c in red}
    if not red or any(k in seen for k in keys.values()) or not all(p["red_ids"].get(c) for c in red):
        return red
    if not all(is_infra_failure(log_tail(p["red_ids"][c])) for c in red):
        return red
    if proof_status(p, seen):                     # no rerun of a head the proof gate bars (the slot loop reports it)
        return red
    for c in red:
        run = sh("gh", "api", f"repos/{REPO}/actions/jobs/{p['red_ids'][c]}", "--jq", ".run_id")
        log.append(f"INFRA-RERUN #{n} {c} (run {run}): runner infrastructure failure, re-running failed jobs once")
        if not DRY and run:
            seen[keys[c]] = int(time.time())
            sh("gh", "run", "rerun", run, "--failed", "--repo", REPO)
    return []


def _update_step(n, p, blocked, seen, log, attention):
    """update-branch makes a plain merge commit that DOES trigger CI (it is not the `[skip ci]` sync head), so a
    barred PR is not updated unless it is already green. A fork head whose author disallows maintainer edits cannot
    be updated by us: raise a "needs manual sync" attention item once per head instead of a failing API call."""
    bo = sh(str(S / "behind-ok"), str(n))
    if not (" UPDATE " in f" {bo} " or "UPDATE" in bo.split()[1:2]):
        return False
    if blocked and not sh(str(S / "ci-gate"), str(n)).endswith("GREEN"):
        return True
    if p.get("isCrossRepository") and not p.get("maintainerCanModify"):
        page_manual_sync(n, p, seen, attention)   # a fork head can be updated only when its author allows maintainer edits
        return True
    log.append(f"update-branch #{n} ({bo})")
    if not DRY:
        sh("gh", "api", "-X", "PUT", f"repos/{REPO}/pulls/{n}/update-branch", "-f", f"expected_head_sha={p['headRefOid']}")
    return True


def _recheck_step(n, p, runs_here, blocked, seen, log, dispatching=False):
    if not (RECHECK.get(str(n)) == p["headRefOid"][:9] and any(r.endswith("\tfailure") for r in runs_here)):
        return False
    if dispatching:
        return True       # the fresh evaluation is a new dispatch GENERATION at the same head (slot_ci_phase bumped it)
    # Legacy: a rerun replays the ORIGINAL event payload, so a metadata-only fix never clears by rerun. A fresh
    # head does: ask the sync for its empty start-CI commit, once per head.
    k = f"{n}:recheck-start-ci:{p['headRefOid']}"
    if k not in seen and not blocked and not p.get("isCrossRepository"):
        seen[k] = int(time.time())
        log.append(f"start-ci #{n} (stale red at a recheck head: fresh event needed)")
        if not DRY:
            sh("gh", "workflow", "run", "sync-branches-with-main.yml", "--repo", REPO, "-f", f"start_ci_for_pr={n}")
    return True


def slot_ci_phase(n, p, blocked, seen, log, attention, skip_dispatch=False):
    """CI starters for one slot PR. Returns True when the tick for this PR ends here. `blocked` bars only the
    starters (recheck start-ci, cancelled-run rerun, start_ci_or_report, update-branch of a non-green PR)."""
    if _update_step(n, p, blocked, seen, log, attention):
        return True
    gen_k, rk = f"{n}:dispatch-gen:{p['headRefOid']}", f"{n}:recheck-gen:{p['headRefOid']}"
    if RECHECK.get(str(n)) == p["headRefOid"][:9] and rk not in seen and not blocked and not DRY:
        seen[rk] = int(time.time())               # owner-verified stale red: ask for a fresh evaluation, same head
        seen[gen_k] = seen.get(gen_k, 0) + 1
        log.append(f"dispatch #{n} again (stale red at a recheck head), generation {seen[gen_k]}")
    dispatching = not blocked and not skip_dispatch and dispatch_ci(n, p, seen, log, attention, seen.get(gen_k, 0))   # False = legacy
    runs_here = sh("gh", "api", f"repos/{REPO}/actions/runs?head_sha={p['headRefOid']}&per_page=100",
                   "--jq", '.workflow_runs[]|[.id, .status, (.conclusion // "")]|@tsv').splitlines()
    if _recheck_step(n, p, runs_here, blocked, seen, log, dispatching):
        return True
    cancelled = [r.split("\t")[0] for r in runs_here if r.endswith("\tcancelled")]
    live = any(r.split("\t")[1] != "completed" for r in runs_here if r)
    if cancelled and not live and not blocked:    # judge by Actions runs only: outside apps (semgrep) are not CI
        log.append(f"rerun {len(cancelled)} cancelled run(s) #{n}")
        if not DRY:
            for rid in cancelled:
                sh("gh", "run", "rerun", rid, "--repo", REPO)
        return True
    gate = sh(str(S / "ci-gate"), str(n))
    if gate.endswith("GREEN"):
        return False
    if not blocked and not dispatching and not p.get("unparked"):   # legacy only: an unparked PR's ready_for_review event starts its own suite
        # never stall silently: ask Actions whether a run is live
        start_ci_or_report(n, p, gate, seen, log, attention)
    return True


def slot_land_phase(n, p, r, seen, log, attention):
    """Review, threads, migration-gate and merge for a green slot PR (merged at once; slots land in arrival order via land_order). Never gated by the proof gate."""
    rv = r.hgetall(f"lg:pr:{n}")
    unresolved = sum(1 for t in p["reviewThreads"]["nodes"] if not t["isResolved"])
    if is_external(p) and (rv.get("review_verdict") != "approve" or not review_carries(rv.get("review_sha", ""), p["headRefOid"], n)):
        k = f"{n}:review:{p['headRefOid']}"   # owner 2026-11-28: a ledger approve applies to EXTERNAL PRs only
        if k not in seen:
            seen[k] = int(time.time())
            attention.append({"pr": n, "kind": "review", "owner": p["owner"], "owner_state": p["alive"],
                              "branch": p["headRefName"], "head": p["headRefOid"][:9]})
    elif not is_external(p) and proof_status(p, seen):
        k = f"{n}:land-proof:{p['headRefOid']}"   # own PRs merge on quality: green, 0 threads, not behind, proof table valid
        if k not in seen:
            seen[k] = int(time.time())
            log.append(f"#{n} green but the requirement-proof check fails: no merge")
    elif unresolved:
        k = f"{n}:threads:{p['headRefOid']}:{unresolved}"   # say it once per head and count, not every tick
        if k not in seen:
            seen[k] = int(time.time())
            log.append(f"#{n} green+approved but {unresolved} unresolved thread(s)")
    elif str(n) in MIGRATION_GROUP and not migration_gate_ran(p["headRefOid"]):
        k = f"{n}:migration-gate-skipped:{p['headRefOid']}"   # owner c3: the real-DB admin test skips
        if k not in seen:                                        # without Postgres, so the gate must RUN
            seen[k] = int(time.time())
            log.append(f"#{n} green but run-migration-gate did not succeed at this head: no merge")
    else:
        log.append(f"merge #{n}")
        if not DRY:
            log.append(sh(str(S / "safe-merge"), str(n)))


def land_order(slots):
    """Arrival order: when several slot PRs are green in one tick the lower PR number merges first."""
    return sorted(slots)


def is_parked(p):
    return any(l["name"] == PARK_LABEL for l in (p.get("labels") or {}).get("nodes", []))


def kept_slots(held, open_nums, r, release=()):
    """Slots this tool granted stay until the PR merges, closes or gets a ledger hold (owner 2026-11-28: "go till it's
    finished"). Red, merge conflict and fork CI awaiting approval keep the slot. Only the PRs in `release` (empty
    diff, unmet declared dependency, fork stuck behind with maintainer edits off) give it up. The ledger hold on the
    PR (`lg:hold:pr:N`) is what frees the slot; the 6h TTL is re-armed while the PR is still landing."""
    keep = [n for n, h in held.items() if h.get("by") == ME and n in open_nums and n not in release
            and not r.exists(f"lg:hold:pr:{n}")]
    for n in keep:
        if not DRY and r.ttl(f"lg:hold:ci-slot:{n}") < 3600:
            sh(str(S / "ledger"), "--as", ME, "hold", f"ci-slot:{n}", "FIFO slot (pr-coordinator)", "--ttl", "6h")
    return keep


def stuck_slot_pages(prs, slots, seen, log, attention, now=None):
    """A re-armed TTL can hold a red or conflicting slot forever: page once per head when a slot PR has been red
    or conflicting for more than STUCK_SLOT_SECS (deduped through notified.json)."""
    now = int(now or time.time())
    for p in prs:
        n, since_k = p["number"], f"{p['number']}:slot-stuck-since"
        if n not in slots or not (p.get("red") or p.get("mergeable") == "CONFLICTING"):
            seen.pop(since_k, None)
            continue
        since = seen.setdefault(since_k, now)
        k = f"{n}:slot-stuck:{p['headRefOid']}"
        if now - since > STUCK_SLOT_SECS and k not in seen:
            seen[k] = now
            log.append(f"#{n} holds a slot but has been red/conflicting for over {STUCK_SLOT_SECS // 3600}h")
            attention.append({"pr": n, "kind": "slot-stuck", "owner": p.get("owner"), "owner_state": p.get("alive"),
                              "branch": p.get("headRefName"), "head": p["headRefOid"][:9], "title": p.get("title", "")[:70]})


def approve_fork_runs(n, p, seen, log, attention):
    """A fork's runs wait for a maintainer approval: the coordinator approves them (owner 2026-11-27), once per head.
    The dedupe key is set only after the run list AND every approve succeeded, so a failure is retried next tick."""
    k = f"{n}:fork-approved:{p['headRefOid']}"
    if k in seen:
        return
    log.append(f"approve fork runs #{n}")
    if DRY:
        return
    rc, out, err = sh_rc("gh", "api", "--paginate", f"repos/{REPO}/actions/runs?head_sha={p['headRefOid']}&per_page=100",
                         "--jq", '.workflow_runs[]|select(.conclusion=="action_required")|.id')
    if rc:
        log.append(f"ATTENTION #{n} list fork runs failed rc={rc}: {err[:120]}")
        attention.append({"pr": n, "kind": "gh-failed", "step": "list fork runs", "rc": rc, "owner": p.get("owner"),
                          "head": p.get("headRefOid", "")[:9]})
        return
    failed = False
    for rid in out.split():
        rc, _, err = sh_rc("gh", "api", "-X", "POST", f"repos/{REPO}/actions/runs/{rid}/approve")
        if rc:
            failed = True
            log.append(f"ATTENTION #{n} approve run {rid} failed rc={rc}: {err[:120]}")
    if not failed:
        seen[k] = int(time.time())


def _gh(n, p, what, attention, log, *cmd):
    """Run one gh step; a non-zero return code is surfaced as a log line and an ATTENTION item. True on success."""
    rc, _, err = sh_rc(*cmd)
    if rc:
        log.append(f"ATTENTION #{n} {what} failed rc={rc}: {err[:120]}")
        attention.append({"pr": n, "kind": "gh-failed", "step": what, "rc": rc, "owner": p.get("owner"),
                          "head": p.get("headRefOid", "")[:9]})
    return rc == 0


def _unpark(n, p, log, attention):
    """Admission: `gh pr ready` first; the label is dropped ONLY if it succeeded, so a failure stays retryable."""
    if p["isDraft"]:
        if not _gh(n, p, "gh pr ready", attention, log, "gh", "pr", "ready", str(n), "--repo", REPO):
            return False
        p["isDraft"], p["unparked"] = False, True
    _gh(n, p, "remove label", attention, log, "gh", "pr", "edit", str(n), "--repo", REPO, "--remove-label", PARK_LABEL)
    return True


def _park(n, p, state, log, attention):
    """Label FIRST, then `--undo`: a partial failure leaves a labelled ready PR, which the next tick re-drafts."""
    if not is_parked(p):
        if not state["label_made"]:
            if not _gh(n, p, "label create", attention, log, "gh", "label", "create", PARK_LABEL, "--repo", REPO,
                       "--force", "--color", "ededed", "--description", "drafted by pr-coordinator: not admitted to a CI slot"):
                return
            state["label_made"] = True
        if not _gh(n, p, "add label", attention, log, "gh", "pr", "edit", str(n), "--repo", REPO, "--add-label", PARK_LABEL):
            return
    _gh(n, p, "gh pr ready --undo", attention, log, "gh", "pr", "ready", "--undo", str(n), "--repo", REPO)


def unpark_phase(prs, slots, log, seen=None, attention=None):
    """Before cutover (#20825: dev-skills #78 stopped parking too early) every pull_request event starts a suite, so
    every open non-draft non-slot PR is drafted and labelled `ci-parked`, and an admitted PR carrying the label is
    made ready again. AFTER cutover (main's ci.yml has no pull_request trigger) nothing is parked and every remaining
    `ci-parked` PR is unparked once, except LAST (the release promotion PR, promoted by hand). Unreadable cutover: do nothing. A draft without the label is the author's own and
    is never touched. Returns the admitted PRs whose unpark failed."""
    attention = [] if attention is None else attention
    failed, cut, state = set(), cutover_state(), {"label_made": False}
    if cut is None:
        return failed
    for p in prs:
        n = p["number"]
        if is_parked(p) and (n in slots or (cut and n not in LAST)):   # LAST stays a draft: promoted by hand
            log.append(f"unpark #{n} ({'admitted to a slot' if n in slots else 'cutover: parking is over'}): gh pr ready, drop {PARK_LABEL}")
            if not DRY and not _unpark(n, p, log, attention):
                failed.add(n)
        elif not cut and n not in slots and not p["isDraft"]:
            log.append(f"park #{n} (no CI slot, before cutover): gh pr ready --undo, label {PARK_LABEL}")
            if not DRY:
                _park(n, p, state, log, attention)
    return failed


def unblocker_first(eligible, unblock):
    """Unblocker-lane PRs first, everything else keeps arrival order."""
    return [n for n in eligible if n in unblock] + [n for n in eligible if n not in unblock]


PROOF_WHY = "proof table missing/invalid: no slot until fixed"


def admission_why(p, r, red, deps, open_now, seen):
    """Why PR p gets no slot ("" = eligible). Arrival order is the owner goal (2026-11-28: land all PRs in order), so
    dependabot PRs are eligible like any external PR (ledger approve applies). A PARKED draft's red is not evidence:
    its work jobs are skipped while it is a draft, and on admission it is unparked, synced and gets a fresh suite,
    so the red exclusions apply only to a non-parked PR."""
    n = p["number"]
    parked = is_parked(p)
    rvb = r.hgetall(f"lg:pr:{n}")
    if rvb.get("review_verdict") == "blocked" and p["headRefOid"].startswith(rvb.get("review_sha", "-")) \
            and SIGNAL_RUN.get(str(n)) != rvb.get("review_sha", "")[:9]:
        p["why"] = "review BLOCKED at this head: changes requested, so no slot until a new head"
    elif r.exists(f"lg:hold:pr:{n}"):       # a session's `ledger hold pr:<n>` parks it: no slot, no merge
        p["why"] = "held: " + (r.hget(f"lg:hold:pr:{n}", "reason") or "")[:60]
    elif p["isDraft"] and not parked:         # a parked draft is ours: it can still be admitted
        p["why"] = "draft"
    elif n in LAST:                           # release promotion: promoted by hand
        p["why"] = "parked by owner (release promotion): report only, no slot"
    elif p["headRefName"].startswith("train-") and not r.exists("lg:hold:trainmaster"):
        p["why"] = "old merge train: no slot without an active trainmaster"   # owner 2026-11-18
    elif p["mergeable"] == "CONFLICTING":
        p["why"] = "conflicts with main"
    elif p["changedFiles"] == 0:              # nothing to land: a full suite here buys nothing
        p["why"] = "empty diff vs main"
    elif any(d in open_now for d in deps.get(str(n), [])):   # declared order: lands after its dependency
        p["why"] = "waits for #" + ", #".join(str(d) for d in deps[str(n)] if d in open_now)
    elif fork_stuck_behind(p):                # no pre-emption would keep this slot forever: release it
        p["why"] = "fork behind, maintainer edits off: needs manual sync"
    elif p["awaiting"]:
        p["why"] = "fork CI awaits workflow approval"
    elif red and not parked:
        p["why"] = "red"
    elif not parked and f"{n}:red:{p['headRefOid']}" in seen:   # paged red at THIS head; a later cancel must not hide it
        p["why"] = "red at this head (owner paged); waits for a new head"
    elif proof_status(p, seen):   # a kept slot is held until merge, so a PR that can never start CI must not take one
        p["why"] = PROOF_WHY
    else:
        p["why"] = ""
    return p["why"]


def main():
    lg = ledger_mod()
    r = lg.conn()
    _REDIS[:] = [r]
    STATE.mkdir(parents=True, exist_ok=True)
    seen_path = STATE / "notified.json"
    seen = json.loads(seen_path.read_text(encoding="utf-8")) if seen_path.exists() else {}
    recent_path = STATE / "recent-cancels.json"
    if recent_path.exists():
        RECENT.update({k: v for k, v in json.loads(recent_path.read_text(encoding="utf-8")).items()
                       if time.time() - v < 600})
    if r.exists("lg:hold:trainmaster"):
        print("trainmaster active — train rules apply; pr-coordinator reports only")
        globals()["DRY"] = True

    prs = sorted(fetch_prs(), key=admission_key)
    runs = actions_runs()
    held = {int(k.rsplit(":", 1)[1]): r.hgetall(k) for k in r.scan_iter("lg:hold:ci-slot:*")}
    open_nums = {p["number"] for p in prs}
    log, attention, rows, eligible = [], [], [], []
    deps_path = STATE / "deps.json"                # {"<pr>": [<pr it must land after>, ...]}, set by the coordinator
    deps = json.loads(deps_path.read_text(encoding="utf-8")) if deps_path.exists() else {}
    open_now = {p["number"] for p in prs}
    pr_claims = {int(k.rsplit(":", 1)[1]): r.hget(k, "owner") or "?" for k in r.scan_iter("lg:claim:pr:*")}
    log.extend(stale_pr_claims(pr_claims, open_now))
    runaway_page(prs, seen, attention)

    for p in prs:
        n, red, active, total = p["number"], *ci_state(p)
        p["red"], p["active"], p["total"] = red, active, total
        p["red"] = red = infra_rerun(p, seen, log)
        p["awaiting"] = fork_awaiting_approval(p, red)
        if not p["awaiting"] and p.get("isCrossRepository") and not p["total"] and not p["isDraft"] \
                and p["mergeable"] != "CONFLICTING":
            p["awaiting"] = fork_runs_await_approval(p)   # no check runs at all: look at the Actions runs
        if p["awaiting"]:
            p["red"] = red = []                   # not a failure: the fork's runs wait for a maintainer to approve them
        p["owner"], p["alive"] = owner_of(r, lg, p)
        p["why"] = admission_why(p, r, red, deps, open_now, seen)
        if p["why"] == PROOF_WHY:                 # once per head: the owner session or coordinator fixes the body
            proof_blocked(p, seen, log, attention)
        if not p["why"]:
            eligible.append(n)
        def page(kind, key, **extra):
            k = f"{n}:{kind}:{key}"
            if k not in seen:
                seen[k] = int(time.time())
                attention.append({"pr": n, "kind": kind, "owner": p["owner"], "owner_state": p["alive"],
                                  "branch": p["headRefName"], "head": p["headRefOid"][:9], "title": p["title"][:70], **extra})
        if p["why"] == "conflicts with main":     # a conflict makes every other verdict moot
            page("conflict", p["headRefOid"])
        elif fork_stuck_behind(p):
            page_manual_sync(n, p, seen, attention)
        elif p["awaiting"]:
            page("fork-approval", p["headRefOid"])
        elif red and not is_parked(p):            # rule 4 (a parked draft is red by design)
            page("red", p["headRefOid"], checks=red)
        fresh = [(tid, ts, url) for tid, ts, url in rabbit_threads(p) if f"{n}:coderabbit:{tid}:{ts}" not in seen]
        if fresh:                                 # rule 3: one page per PR, every new thread marked seen
            for tid, ts, _ in fresh[1:]:
                seen[f"{n}:coderabbit:{tid}:{ts}"] = int(time.time())
            page("coderabbit", f"{fresh[0][0]}:{fresh[0][1]}", threads=len(fresh), url=fresh[0][2])

    # rule 2 + 1: slots = live holds by others first, then FIFO-eligible up to WIDTH
    slots = [n for n in sorted(held, key=lambda x: next((i for i, p in enumerate(prs) if p["number"] == x), 999))
             if n in open_nums and held[n].get("by") != ME]
    # no pre-emption: a slot this tool granted is kept until the PR merges, closes or gets a ledger hold, through
    # red, conflict and fork-awaiting-approval (owner 2026-11-28); it is released only for an empty diff, an unmet
    # declared dependency or a fork stuck behind. Only FREE slots are filled in FIFO order
    release = {p["number"] for p in prs if p["changedFiles"] == 0 or fork_stuck_behind(p)
               or any(d in open_now for d in deps.get(str(p["number"]), []))
               or (p.get("isCrossRepository") and dispatch_enabled() and cutover_done()
                   and not fork_approved(p["number"], p["headRefOid"]))}   # no CI path for an unapproved fork: do not hold the slot
    slots += [n for n in kept_slots(held, open_nums, r, release) if n not in slots][:max(0, WIDTH - len(slots))]
    # unblocker lane (owner 2026-11-18): a PR that fixes main itself or stops data loss takes the next
    # FREE slot ahead of FIFO and may land ahead of older slot PRs; it never pre-empts a running slot.
    # Marked with `ledger set <pr> --batch unblocker`.
    unblock = {n for n in eligible if r.hget(f"lg:pr:{n}", "batch") == "unblocker"}
    eligible = unblocker_first(eligible, unblock)
    for n in eligible:
        if len(slots) >= WIDTH:
            break
        if n not in slots:
            slots.append(n)
    unpark_failed = unpark_phase(prs, slots, log, seen, attention)   # unpark BEFORE `land-next` is added below
    stuck_slot_pages(prs, slots, seen, log, attention)
    for n, h in held.items():
        if h.get("by") == ME and n not in slots:
            log.append(f"unhold ci-slot:{n}")
            if not DRY:
                sh(str(S / "ledger"), "--as", ME, "unhold", f"ci-slot:{n}")
                if n in open_nums:                # owner 2026-11-18: only slot PRs are synced with main
                    sh("gh", "pr", "edit", str(n), "--repo", REPO, "--remove-label", SLOT_LABEL)
    for n in slots:
        if n not in held:
            log.append(f"hold ci-slot:{n}")
            if not DRY:
                sh(str(S / "ledger"), "--as", ME, "hold", f"ci-slot:{n}", "FIFO slot (pr-coordinator)", "--ttl", "6h")
                if n not in unpark_failed:
                    sh("gh", "pr", "edit", str(n), "--repo", REPO, "--add-label", SLOT_LABEL)

    pmap0 = {p["number"]: p for p in prs}
    slot_heads = {(pr_repo(pmap0[n]), pmap0[n]["headRefName"]) for n in slots if n in pmap0} | mirror_keep_heads(prs, slots)
    if not DRY:
        mirror_cleanup(prs, slots, log, seen)
    sweep_runs(runs, prs, lambda p: ("" if p["number"] in slots else      # an admitted PR's runs are never cancelled, red or not
                                     f"rule4: red at head ({', '.join(p['red'][:3])})" if p["red"] else "rule2: no CI slot (FIFO)"),
               slot_heads, "rule2: branch has no open PR and no CI slot", log)

    pmap = {p["number"]: p for p in prs}
    # owner 2026-11-28: a green slot PR that passes every gate merges now, never held for the other slot (the
    # second merger re-syncs and re-runs anyway). Both green in one tick: lower PR number (arrival order) first.
    # The unblocker lane affects ADMISSION only.
    for n in land_order(slots):
        p = pmap[n]
        if n in held and held[n].get("by") != ME:
            continue                              # another session drives its own slot
        if p["awaiting"] and (not dispatch_enabled() or cutover_state() is False):
            approve_fork_runs(n, p, seen, log, attention)   # legacy, secretless event runs (dropped in PR-B)
        blocked = proof_blocked(p, seen, log, attention)   # gates ONLY the CI starters; every other page still runs
        if not blocked:
            preboard_advisory(n, p, seen, log, attention)  # advisory only: never changes what happens next (#49)
        if slot_ci_phase(n, p, blocked, seen, log, attention, skip_dispatch=n in unpark_failed):
            continue
        slot_land_phase(n, p, r, seen, log, attention)

    if not DRY:
        prune_seen(seen)
        write_atomic(seen_path, json.dumps(seen))
        write_atomic(recent_path, json.dumps(RECENT))
        sh("redis-cli", "--no-auth-warning", "-n", "15", "DEL", "claude:landing-order")
        if eligible:
            sh("redis-cli", "--no-auth-warning", "-n", "15", "RPUSH", "claude:landing-order", *map(str, eligible))
    for pos, p in enumerate(prs, 1):
        slot = "SLOT" if p["number"] in slots else ""
        ci = "red" if p["red"] else ("running" if p["active"] else ("none" if not p["total"] else "done"))
        rows.append(f"| {pos} | #{p['number']} | {ms_label(p)} | {p['createdAt'][:16]} | {slot} | {ci} | {p['why'] or 'ready'} "
                    f"| {p['owner']} ({p['alive']}) | {p['title'][:55]} |")
    table = "| # | PR | ms | submitted (UTC) | slot | CI | state | owner | title |\n|---|---|---|---|---|---|---|---|---|\n" + "\n".join(rows)
    # a --dry view (push-and-park) must not clobber the live queue.md: it writes queue.dry.md instead
    write_atomic(STATE / ("queue.dry.md" if DRY else "queue.md"),
                 f"# PR queue — {time.strftime('%F %T')} (dry={DRY})\n\n{table}\n")
    print(f"slots={slots} eligible={len(eligible)} open={len(prs)} dry={DRY}")
    for line in log:
        print("ACTION", line)
    if not DRY and attention:                 # the coordinator session drains this and pages owners
        with open(STATE / "attention.jsonl", "a", encoding="utf-8") as fh:
            fh.writelines(json.dumps({"ts": int(time.time()), **a}) + "\n" for a in attention)
    for a in attention:
        print("ATTENTION", json.dumps(a))


def degraded_tick(err):
    """GraphQL refused (secondary rate limit): keep rule 2 alive on REST alone. Slots stay as held;
    every other open PR's runs are cancelled. No pages, no slot moves, no merges until GraphQL returns."""
    lg = ledger_mod()
    r = lg.conn()
    STATE.mkdir(parents=True, exist_ok=True)
    recent_path = STATE / "recent-cancels.json"
    if recent_path.exists():
        RECENT.update({k: v for k, v in json.loads(recent_path.read_text(encoding="utf-8")).items()
                       if time.time() - v < 600})
    held = {int(k.rsplit(":", 1)[1]) for k in r.scan_iter("lg:hold:ci-slot:*")}
    raw = sh("gh", "api", "--paginate", f"repos/{REPO}/pulls?state=open&per_page=100",
             "--jq", ".[]|[.number,.head.ref,.head.sha,(.head.repo.full_name // \"\")]|@tsv")
    prs = [{"number": int(f[0]), "headRefName": f[1], "headRefOid": f[2], "headRepository": {"nameWithOwner": f[3]}}
           for f in (line.split("\t") for line in raw.splitlines() if line)]
    log = []
    sweep_runs(actions_runs(), prs, lambda p: "" if p["number"] in held else "rule2: no CI slot (FIFO, degraded tick)",
               set(), "rule2: no CI slot (FIFO, degraded tick)", log)
    if not DRY:
        write_atomic(recent_path, json.dumps(RECENT))
    print(f"DEGRADED tick ({err[:80]}): slots held={sorted(held)}")
    for line in log:
        print("ACTION", line)


def take_pass_lock():
    """Exclusive non-blocking flock on LOCK_PATH (distinct from the loop's lock file). Returns the open handle, or None if held."""
    fh = open(LOCK_PATH, "a", encoding="utf-8")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fh.close()
        return None
    return fh


def run_cli(argv):
    """Strict argv handling: only the known flags run anything. Returns an exit code, or None after a live pass."""
    if argv in (["-h"], ["--help"]):
        print(USAGE)
        return 0
    if len(argv) == 2 and argv[0] == "--proof-check":
        return proof_check_cli(argv[1])
    if len(argv) == 2 and argv[0] == "--dispatch" and argv[1].isdigit():
        return dispatch_cli(int(argv[1]))
    if len(argv) == 2 and argv[0] == "--findings-gate" and argv[1].isdigit():
        return findings_gate_cli(int(argv[1]))
    if argv not in ([], ["--dry"]):
        print(f"pr-coordinator: unknown arguments {argv}\n{USAGE}", file=sys.stdout)
        return 2
    lock = None if argv == ["--dry"] else take_pass_lock()
    if argv != ["--dry"] and lock is None:
        print("another coordinator pass is running")
        return 0
    try:
        main()
    except SystemExit as exc:
        if "rate limit" not in str(exc):
            raise
        degraded_tick(str(exc))
    finally:
        if lock:
            lock.close()
    return None


if __name__ == "__main__":
    code = run_cli(sys.argv[1:])
    if code is not None:
        raise SystemExit(code)
